<Page
    x:Class="CSC13001_my_shop_project.Presentation.ServerConfiguration.ServerConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CSC13001_my_shop_project.Presentation.Controls"
    xmlns:converters="using:CSC13001_my_shop_project.Presentation.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AuthPanelBackgroundBrush}"
>
    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="AuthInputFocusBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="AuthInputFocusRingBrush" Color="{StaticResource BrandColor}" />
        <SolidColorBrush x:Key="AuthInputPlaceholderBrush" Color="#D0D0D0" />

        <Style x:Key="AuthFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AuthTextInputBrush}" />
            <Setter
                Property="PlaceholderForeground"
                Value="{StaticResource AuthInputPlaceholderBrush}"
            />
            <Setter Property="SelectionHighlightColor" Value="{StaticResource BrandColor}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <TextBlock
                                x:Name="PlaceholderTextContentPresenter"
                                Text="{TemplateBinding PlaceholderText}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                FontWeight="Thin"
                                FontSize="13"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                            />
                            <ScrollViewer
                                x:Name="ContentElement"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthFieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{StaticResource AuthTextInputBrush}" />
            <Setter
                Property="PlaceholderForeground"
                Value="{StaticResource AuthInputPlaceholderBrush}"
            />
            <Setter Property="SelectionHighlightColor" Value="{StaticResource BrandColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="PasswordRevealMode" Value="Hidden" />
        </Style>

        <Style x:Key="AuthFlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                        />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthInputIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" x:Name="LeftColumn" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" MinWidth="480" x:Name="HeroPanel">
            <Image
                Source="ms-appx:///Assets/Auth/lumina-hero.png"
                Stretch="UniformToFill"
                VerticalAlignment="Bottom"
            />
            <Rectangle Fill="{StaticResource AuthHeroOverlayBrush}" />

            <Grid Margin="40">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="22">
                    <Run Text="LUMINA " Foreground="White" FontWeight="Bold" />
                    <Run Text="HAVEN" Foreground="{StaticResource BrandColor}" FontWeight="Light" />
                </TextBlock>

                <StackPanel VerticalAlignment="Bottom" Spacing="16">
                    <TextBlock
                        Foreground="{StaticResource AuthTextOnHeroBrush}"
                        FontSize="42"
                        LineHeight="52"
                        Style="{x:Null}"
                        HorizontalAlignment="Left"
                        CharacterSpacing="-30"
                        TextWrapping="WrapWholeWords"
                        MaxWidth="520"
                    >
                        "Configure your backend connection settings."
                    </TextBlock>
                    <TextBlock
                        Text="Server Configuration — connect to your database securely."
                        Foreground="{StaticResource AuthTextOnHeroMutedBrush}"
                        FontSize="13"
                    />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" MinWidth="460">
            <ScrollViewer x:Name="FormScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="0,48"
                    Spacing="20"
                    x:Name="FormStackPanel"
                >
                    <Button
                        HorizontalAlignment="Left"
                        Style="{StaticResource AuthFlatButtonStyle}"
                        Command="{Binding BackToLogin}"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                <Path
                                    Data="M8 12.6667L3.33333 8L8 3.33333"
                                    Stroke="{StaticResource AuthTextLabelBrush}"
                                    StrokeThickness="1.33"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                />
                                <Path
                                    Data="M12.6667 8H3.33333"
                                    Stroke="{StaticResource AuthTextLabelBrush}"
                                    StrokeThickness="1.33"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                />
                            </Canvas>
                            <TextBlock
                                Text="Back to login"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AuthTextLabelBrush}"
                                FontSize="13"
                                FontWeight="Medium"
                            />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Server Configuration"
                            FontSize="28"
                            LineHeight="42"
                            CharacterSpacing="-35"
                            FontWeight="Bold"
                            Style="{x:Null}"
                            Foreground="{StaticResource AuthTextStrongBrush}"
                        />
                        <TextBlock
                            Text="Configure your backend database connection"
                            FontSize="14"
                            Foreground="{StaticResource AuthTextMutedBrush}"
                        />
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="SERVER URL / IP ADDRESS"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="120"
                                Foreground="{StaticResource AuthTextLabelBrush}"
                            />
                            <Grid x:Name="ServerUrlFieldChrome">
                                <Border
                                    x:Name="ServerUrlFieldGlow"
                                    Margin="-4"
                                    BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                    BorderThickness="4"
                                    CornerRadius="16"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                />

                                <Border
                                    x:Name="ServerUrlFieldSurface"
                                    Height="50"
                                    CornerRadius="12"
                                    Background="{StaticResource AuthInputBackgroundBrush}"
                                    BorderBrush="{StaticResource AuthInputBorderBrush}"
                                    BorderThickness="1"
                                    Padding="16,0,12,0"
                                >
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="ServerUrlInput"
                                            Style="{StaticResource AuthFieldTextBoxStyle}"
                                            PlaceholderText="http://localhost"
                                            VerticalAlignment="Center"
                                            Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Tag="ServerUrl"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                        />

                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource AuthInputIconButtonStyle}"
                                            CommandParameter="{Binding ElementName=ServerUrlInput}"
                                            Tag="ServerUrl"
                                            Click="OnClearTextClick"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                            Visibility="{Binding Text, ElementName=ServerUrlInput, Converter={StaticResource StringToVisibilityConverter}}"
                                        >
                                            <Canvas Width="16" Height="16">
                                                <Path
                                                    Data="M3.5 3.5L12.5 12.5"
                                                    Stroke="{StaticResource AuthTextLabelBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                />
                                                <Path
                                                    Data="M12.5 3.5L3.5 12.5"
                                                    Stroke="{StaticResource AuthTextLabelBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                />
                                            </Canvas>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    Text="PORT"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="120"
                                    Foreground="{StaticResource AuthTextLabelBrush}"
                                />
                                <Grid x:Name="PortFieldChrome">
                                    <Border
                                        x:Name="PortFieldGlow"
                                        Margin="-4"
                                        BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                        BorderThickness="4"
                                        CornerRadius="16"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                    />

                                    <Border
                                        x:Name="PortFieldSurface"
                                        Height="50"
                                        CornerRadius="12"
                                        Background="{StaticResource AuthInputBackgroundBrush}"
                                        BorderBrush="{StaticResource AuthInputBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16,0,12,0"
                                    >
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                x:Name="PortInput"
                                                Style="{StaticResource AuthFieldTextBoxStyle}"
                                                PlaceholderText="5432"
                                                VerticalAlignment="Center"
                                                Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Tag="Port"
                                                GotFocus="OnFieldElementGotFocus"
                                                LostFocus="OnFieldElementLostFocus"
                                            />

                                            <Button
                                                Grid.Column="1"
                                                Style="{StaticResource AuthInputIconButtonStyle}"
                                                CommandParameter="{Binding ElementName=PortInput}"
                                                Tag="Port"
                                                Click="OnClearTextClick"
                                                GotFocus="OnFieldElementGotFocus"
                                                LostFocus="OnFieldElementLostFocus"
                                                Visibility="{Binding Text, ElementName=PortInput, Converter={StaticResource StringToVisibilityConverter}}"
                                            >
                                                <Canvas Width="16" Height="16">
                                                    <Path
                                                        Data="M3.5 3.5L12.5 12.5"
                                                        Stroke="{StaticResource AuthTextLabelBrush}"
                                                        StrokeThickness="1.5"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                    />
                                                    <Path
                                                        Data="M12.5 3.5L3.5 12.5"
                                                        Stroke="{StaticResource AuthTextLabelBrush}"
                                                        StrokeThickness="1.5"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                    />
                                                </Canvas>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    Text="DATABASE"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="120"
                                    Foreground="{StaticResource AuthTextLabelBrush}"
                                />
                                <Grid x:Name="DatabaseFieldChrome">
                                    <Border
                                        x:Name="DatabaseFieldGlow"
                                        Margin="-4"
                                        BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                        BorderThickness="4"
                                        CornerRadius="16"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                    />

                                    <Border
                                        x:Name="DatabaseFieldSurface"
                                        Height="50"
                                        CornerRadius="12"
                                        Background="{StaticResource AuthInputBackgroundBrush}"
                                        BorderBrush="{StaticResource AuthInputBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16,0,12,0"
                                    >
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                x:Name="DatabaseInput"
                                                Style="{StaticResource AuthFieldTextBoxStyle}"
                                                PlaceholderText="luminahaven_db"
                                                VerticalAlignment="Center"
                                                Text="{Binding Database, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Tag="Database"
                                                GotFocus="OnFieldElementGotFocus"
                                                LostFocus="OnFieldElementLostFocus"
                                            />

                                            <Button
                                                Grid.Column="1"
                                                Style="{StaticResource AuthInputIconButtonStyle}"
                                                CommandParameter="{Binding ElementName=DatabaseInput}"
                                                Tag="Database"
                                                Click="OnClearTextClick"
                                                GotFocus="OnFieldElementGotFocus"
                                                LostFocus="OnFieldElementLostFocus"
                                                Visibility="{Binding Text, ElementName=DatabaseInput, Converter={StaticResource StringToVisibilityConverter}}"
                                            >
                                                <Canvas Width="16" Height="16">
                                                    <Path
                                                        Data="M3.5 3.5L12.5 12.5"
                                                        Stroke="{StaticResource AuthTextLabelBrush}"
                                                        StrokeThickness="1.5"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                    />
                                                    <Path
                                                        Data="M12.5 3.5L3.5 12.5"
                                                        Stroke="{StaticResource AuthTextLabelBrush}"
                                                        StrokeThickness="1.5"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                    />
                                                </Canvas>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="USERNAME"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="120"
                                Foreground="{StaticResource AuthTextLabelBrush}"
                            />
                            <Grid x:Name="UsernameFieldChrome">
                                <Border
                                    x:Name="UsernameFieldGlow"
                                    Margin="-4"
                                    BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                    BorderThickness="4"
                                    CornerRadius="16"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                />

                                <Border
                                    x:Name="UsernameFieldSurface"
                                    Height="50"
                                    CornerRadius="12"
                                    Background="{StaticResource AuthInputBackgroundBrush}"
                                    BorderBrush="{StaticResource AuthInputBorderBrush}"
                                    BorderThickness="1"
                                    Padding="16,0,12,0"
                                >
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="UsernameInput"
                                            Style="{StaticResource AuthFieldTextBoxStyle}"
                                            PlaceholderText="admin"
                                            VerticalAlignment="Center"
                                            Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Tag="Username"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                        />

                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource AuthInputIconButtonStyle}"
                                            CommandParameter="{Binding ElementName=UsernameInput}"
                                            Tag="Username"
                                            Click="OnClearTextClick"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                            Visibility="{Binding Text, ElementName=UsernameInput, Converter={StaticResource StringToVisibilityConverter}}"
                                        >
                                            <Canvas Width="16" Height="16">
                                                <Path
                                                    Data="M3.5 3.5L12.5 12.5"
                                                    Stroke="{StaticResource AuthTextLabelBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                />
                                                <Path
                                                    Data="M12.5 3.5L3.5 12.5"
                                                    Stroke="{StaticResource AuthTextLabelBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                />
                                            </Canvas>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="PASSWORD"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="120"
                                Foreground="{StaticResource AuthTextLabelBrush}"
                            />
                            <Grid x:Name="PasswordFieldChrome">
                                <Border
                                    x:Name="PasswordFieldGlow"
                                    Margin="-4"
                                    BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                    BorderThickness="4"
                                    CornerRadius="16"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                />

                                <Border
                                    x:Name="PasswordFieldSurface"
                                    Height="50"
                                    CornerRadius="12"
                                    Background="{StaticResource AuthInputBackgroundBrush}"
                                    BorderBrush="{StaticResource AuthInputBorderBrush}"
                                    BorderThickness="1"
                                    Padding="16,0,12,0"
                                >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <PasswordBox
                                            x:Name="PasswordHiddenInput"
                                            Style="{StaticResource AuthFieldPasswordBoxStyle}"
                                            PlaceholderText="••••••••"
                                            Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                            Tag="Password"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                        />

                                        <TextBox
                                            x:Name="PasswordVisibleInput"
                                            Style="{StaticResource AuthFieldTextBoxStyle}"
                                            PlaceholderText="••••••••"
                                            Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Tag="Password"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                        />

                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource AuthInputIconButtonStyle}"
                                            Tag="Password"
                                            Click="OnTogglePasswordVisibilityClick"
                                            GotFocus="OnFieldElementGotFocus"
                                            LostFocus="OnFieldElementLostFocus"
                                        >
                                            <Grid Width="16" Height="16">
                                                <Canvas
                                                    Width="14"
                                                    Height="10"
                                                    Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                                >
                                                    <Path
                                                        Data="M0.708337 5.56492C0.652777 5.41525 0.652777 5.2506 0.708337 5.10092C1.24947 3.78883 2.16801 2.66695 3.34752 1.87752C4.52702 1.08809 5.91437 0.666667 7.33367 0.666667C8.75297 0.666667 10.1403 1.08809 11.3198 1.87752C12.4993 2.66695 13.4179 3.78883 13.959 5.10092C14.0146 5.2506 14.0146 5.41525 13.959 5.56492C13.4179 6.87702 12.4993 7.9989 11.3198 8.78832C10.1403 9.57775 8.75297 9.99918 7.33367 9.99918C5.91437 9.99918 4.52702 9.57775 3.34752 8.78832C2.16801 7.9989 1.24947 6.87702 0.708337 5.56492Z"
                                                        Stroke="{StaticResource AuthTextInputBrush}"
                                                        StrokeThickness="1.33"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                    />
                                                    <Path
                                                        Data="M2.66667 4.66667C3.77124 4.66667 4.66667 3.77124 4.66667 2.66667C4.66667 1.5621 3.77124 0.666667 2.66667 0.666667C1.5621 0.666667 0.666667 1.5621 0.666667 2.66667C0.666667 3.77124 1.5621 4.66667 2.66667 4.66667Z"
                                                        Stroke="{StaticResource AuthTextInputBrush}"
                                                        StrokeThickness="1.33"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        RenderTransformOrigin="0,0"
                                                    >
                                                        <Path.RenderTransform>
                                                            <TranslateTransform
                                                                X="4.667"
                                                                Y="2.667"
                                                            />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Canvas>

                                                <Canvas
                                                    Width="14"
                                                    Height="10"
                                                    Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                >
                                                    <Path
                                                        Data="M0.708337 5.56492C0.652777 5.41525 0.652777 5.2506 0.708337 5.10092C1.24947 3.78883 2.16801 2.66695 3.34752 1.87752C4.52702 1.08809 5.91437 0.666667 7.33367 0.666667C8.75297 0.666667 10.1403 1.08809 11.3198 1.87752C12.4993 2.66695 13.4179 3.78883 13.959 5.10092C14.0146 5.2506 14.0146 5.41525 13.959 5.56492C13.4179 6.87702 12.4993 7.9989 11.3198 8.78832C10.1403 9.57775 8.75297 9.99918 7.33367 9.99918C5.91437 9.99918 4.52702 9.57775 3.34752 8.78832C2.16801 7.9989 1.24947 6.87702 0.708337 5.56492Z"
                                                        Stroke="{StaticResource AuthTextInputBrush}"
                                                        StrokeThickness="1.33"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                    />
                                                    <Path
                                                        Data="M1.2 9.2L12.8 0.8"
                                                        Stroke="{StaticResource AuthTextInputBrush}"
                                                        StrokeThickness="1.5"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                    />
                                                </Canvas>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <controls:CustomCheckBox Content="Enable SSL connection" />

                        <Border
                            Background="{StaticResource AuthNoteBackgroundBrush}"
                            BorderBrush="{StaticResource AuthNoteBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                        >
                            <TextBlock TextWrapping="Wrap">
                                <Run
                                    Text="Note:"
                                    Foreground="{StaticResource AuthTextStrongBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                />
                                <Run
                                    Text=" Ensure your database server is accessible from this application."
                                    Foreground="{StaticResource AuthTextMutedBrush}"
                                    FontSize="12"
                                />
                            </TextBlock>
                        </Border>

                        <Grid ColumnSpacing="12" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Height="50"
                                Command="{Binding SaveConfiguration}"
                                Background="{StaticResource AuthPrimaryButtonBrush}"
                                BorderThickness="0"
                                CornerRadius="14"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                            >
                                <Grid Width="168" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Canvas
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
