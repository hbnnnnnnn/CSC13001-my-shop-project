<ContentDialog
    x:Class="CSC13001_my_shop_project.Presentation.OrderList.CreateOrderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.OrderList"
    Style="{StaticResource DefaultContentDialogStyle}"
    FullSizeDesired="False"
>
    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#F5EDE4" />
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">1024</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1024</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>

        <!-- ══ TextBox: Remove hover ring, keep focus ring, center placeholder ══ -->
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#F5EDE4" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FAF7F2" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#F3B55C" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FAF7F2" />

        <!-- ══ ComboBox: Remove hover ring ══ -->
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#F5EDE4" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FAF7F2" />

        <!-- Field label style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#992C2118" />
        </Style>

        <!-- Input field style: custom template for precise placeholder alignment (same as OrderListPage search bar) -->
        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#FAF7F2" />
            <Setter Property="BorderBrush" Value="#F5EDE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="50" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#F3B55C" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    Text="{TemplateBinding PlaceholderText}"
                                    Foreground="#992C2118"
                                    FontSize="{TemplateBinding FontSize}"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Date button style: same look as input field, accent border on click, no hover ring -->
        <Style x:Key="DateInputButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FAF7F2" />
            <Setter Property="BorderBrush" Value="#F5EDE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#F3B55C" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#E0A045" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel button: no bg on hover, just darken border -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#992C2118" />
            <Setter Property="BorderBrush" Value="#F5EDE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#D6CEC5" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentText" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#CC2C2118" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#C5BBB0" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentText" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#FF2C2118" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentText"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Submit button: darken bg on hover -->
        <Style x:Key="SubmitBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3B55C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#E0A045" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#CC8C30" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AddProduct link button: underline bar on hover (same as DashboardPage ViewAllLinkStyle) -->
        <Style x:Key="AddProductLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UnderlineBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UnderlineBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UnderlineBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#F3B55C" />
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="ADD PRODUCT" FontSize="12" FontWeight="Bold" Foreground="#F3B55C" CharacterSpacing="30" />
                                    <Rectangle x:Name="UnderlineBar" Height="1" VerticalAlignment="Bottom" Fill="#F3B55C" Opacity="0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status button style (same as GhostButtonStyle from OrderListPage) -->
        <Style x:Key="StatusBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="14">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="1024" MinHeight="680">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER BAR ═══ -->
        <Border
            Grid.Row="0"
            Background="#4DFAF7F2"
            BorderBrush="#F5EDE4"
            BorderThickness="0,0,0,1"
            Padding="32,0"
            Height="86"
        >
            <Grid VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding DialogTitle}"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#FF2C2118"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    CharacterSpacing="50"
                />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource CancelBtnStyle}" />
                    <Button Content="{Binding SubmitButtonText}" Click="SubmitButton_Click" Style="{StaticResource SubmitBtnStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BODY: TWO COLUMNS ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: Customer Details + Order Details ─── -->
            <ScrollViewer Grid.Column="0" Padding="32,32,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24">

                    <!-- Customer Details -->
                    <StackPanel Spacing="16">
                        <Border BorderBrush="#F5EDE4" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <TextBlock Text="Customer Details" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" />
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox
                                x:Name="CustomerPicker"
                                ItemsSource="{Binding AvailableCustomers}"
                                SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                PlaceholderText="Select a customer..."
                                DisplayMemberPath="DisplayText"
                                FontSize="14"
                                Background="#FAF7F2"
                                BorderBrush="#F5EDE4"
                                BorderThickness="1"
                                CornerRadius="14"
                                Height="50"
                                HorizontalAlignment="Stretch"
                            />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox
                                    Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="+1 (555) 000-0000"
                                    Style="{StaticResource FormInputStyle}"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox
                                    Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="email@example.com"
                                    Style="{StaticResource FormInputStyle}"
                                />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="DELIVERY ADDRESS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox
                                Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Enter full address"
                                FontSize="14"
                                Background="#FAF7F2"
                                BorderBrush="#F5EDE4"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,14"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                MinHeight="100"
                            >
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border
                                            x:Name="BorderElement"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver" />
                                                    <VisualState x:Name="Focused">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <SolidColorBrush Color="#F3B55C" />
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Disabled" />
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Grid>
                                                <TextBlock
                                                    x:Name="PlaceholderTextContentPresenter"
                                                    Text="{TemplateBinding PlaceholderText}"
                                                    Foreground="#992C2118"
                                                    FontSize="{TemplateBinding FontSize}"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="Top"
                                                    IsHitTestVisible="False" />
                                                <ScrollViewer
                                                    x:Name="ContentElement"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Order Details -->
                    <StackPanel Spacing="16">
                        <Border BorderBrush="#F5EDE4" BorderThickness="0,0,0,1" Padding="0,16,0,8">
                            <TextBlock Text="Order Details" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" />
                        </Border>

                        <!-- DATE: Button + DatePickerFlyout -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DATE" Style="{StaticResource FieldLabelStyle}" />
                            <Button x:Name="DatePickerButton" Style="{StaticResource DateInputButtonStyle}">
                                <TextBlock x:Name="DateDisplayText" FontSize="16" Foreground="#FF2C2118" VerticalAlignment="Center" />
                                <Button.Flyout>
                                    <DatePickerFlyout x:Name="OrderDateFlyout" DatePicked="DatePickerFlyout_DatePicked" />
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── RIGHT: Products Panel ─── -->
            <Border
                Grid.Column="1"
                Background="#4DFAF7F2"
                BorderBrush="#F5EDE4"
                BorderThickness="1"
                CornerRadius="14"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Products Header -->
                    <Border
                        Grid.Row="0"
                        Background="#80FAF7F2"
                        BorderBrush="#F5EDE4"
                        BorderThickness="0,0,0,1"
                        Padding="24,0"
                        Height="77"
                    >
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Product List" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" VerticalAlignment="Center" />

                            <!-- "+ ADD PRODUCT" link: underline bar on hover -->
                            <Button
                                x:Name="AddProductButton"
                                Click="AddProduct_Click"
                                Style="{StaticResource AddProductLinkStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </Border>

                    <!-- Table Column Headers -->
                    <Grid Grid.Row="1" Padding="24,12" BorderBrush="#F5EDE4" BorderThickness="0,0,0,1" Height="Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="QTY" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="UNIT PRICE" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Product rows / Empty State -->
                    <Grid Grid.Row="2" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater x:Name="ProductList" ItemsSource="{Binding Products}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:OrderProductItem">
                                        <Grid Padding="24,14" BorderBrush="#F5EDE4" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="14" FontWeight="Medium" Foreground="#FF2C2118" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="14" Foreground="#CC2C2118" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding UnitPriceFormatted}" FontSize="13" Foreground="#CC2C2118" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding TotalFormatted}" FontSize="13" FontWeight="Bold" Foreground="#FF2C2118" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="4" Tag="{Binding}" Click="RemoveProduct_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#992C2118" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!-- Empty state -->
                        <StackPanel
                            x:Name="EmptyProductsPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2"
                        >
                            <TextBlock
                                Text="No products added yet."
                                FontSize="14"
                                FontStyle="Italic"
                                Foreground="#662C2118"
                                TextAlignment="Center"
                            />
                            <TextBlock
                                Text="Click &quot;Add Product&quot; to start."
                                FontSize="14"
                                FontStyle="Italic"
                                Foreground="#662C2118"
                                TextAlignment="Center"
                            />
                        </StackPanel>
                    </Grid>

                    <!-- Totals Footer (matching Detail Dialog layout) -->
                    <Border
                        Grid.Row="3"
                        Background="White"
                        BorderBrush="#F5EDE4"
                        BorderThickness="0,1,0,0"
                        Padding="24,16"
                    >
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Subtotal" FontSize="14" Foreground="#992C2118" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding TotalAmountFormatted}" FontSize="14" Foreground="#FF2C2118" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Shipping Fees" FontSize="14" Foreground="#992C2118" HorizontalAlignment="Left" />
                                <TextBlock Text="0 ₫" FontSize="14" Foreground="#FF2C2118" HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="#F5EDE4" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="Total" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TotalAmountText" Text="{Binding TotalAmountFormatted}" FontSize="18" FontWeight="Bold" Foreground="#F3B55C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentDialog>