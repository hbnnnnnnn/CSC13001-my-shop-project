<ContentDialog
    x:Class="CSC13001_my_shop_project.Presentation.OrderList.OrderDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.OrderList"
    Style="{StaticResource DefaultContentDialogStyle}"
    FullSizeDesired="False"
>
    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#F5EDE4" />
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">1024</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1024</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>

        <!-- Field label style (same as CreateOrderDialog) -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#992C2118" />
        </Style>

        <!-- Close Order button: accent border outline -->
        <Style x:Key="CloseOrderBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3B55C" />
            <Setter Property="BorderBrush" Value="#F3B55C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#0DF3B55C" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#1AF3B55C" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="1024" Height="680">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── HEADER BAR (same as CreateOrderDialog) ─── -->
        <Border Grid.Row="0"
                Background="#4DFAF7F2"
                BorderBrush="#F5EDE4"
                BorderThickness="0,0,0,1"
                Padding="32,0"
                Height="86">
            <Grid VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding DialogTitle}"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#FF2C2118"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    CharacterSpacing="50"
                />
                <Button
                    Content="Close Order"
                    Click="CloseButton_Click"
                    Style="{StaticResource CloseOrderBtnStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                />
            </Grid>
        </Border>

        <!-- ─── BODY (same 2-column as Create/Edit) ─── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT COLUMN: Customer + Order Details (form-field style like Create/Edit) ─── -->
            <ScrollViewer Grid.Column="0" Padding="32,32,24,24">
                <StackPanel Spacing="24">

                    <!-- Customer Details section -->
                    <StackPanel Spacing="16">
                        <Border BorderBrush="#F5EDE4" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <TextBlock Text="Customer Details" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" />
                        </Border>

                        <!-- Customer Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="CUSTOMER NAME" Style="{StaticResource FieldLabelStyle}" />
                            <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="14" Height="50" Padding="14,0">
                                <TextBlock Text="{Binding Order.CustomerName}" FontSize="14" Foreground="#FF2C2118" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Phone + Email row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabelStyle}" />
                                <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="14" Height="50" Padding="14,0">
                                    <TextBlock Text="{Binding Order.Phone}" FontSize="14" Foreground="#FF2C2118" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabelStyle}" />
                                <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="14" Height="50" Padding="14,0">
                                    <TextBlock Text="{Binding Order.Email}" FontSize="14" Foreground="#FF2C2118" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Delivery Address -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DELIVERY ADDRESS" Style="{StaticResource FieldLabelStyle}" />
                            <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="14" MinHeight="100" Padding="14,14">
                                <TextBlock Text="{Binding Order.Address}" FontSize="14" Foreground="#FF2C2118" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Order Details section -->
                    <StackPanel Spacing="16">
                        <Border BorderBrush="#F5EDE4" BorderThickness="0,0,0,1" Padding="0,16,0,8">
                            <TextBlock Text="Order Details" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" />
                        </Border>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- STATUS: dot + colored text (same layout as Create/Edit) -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="STATUS" Style="{StaticResource FieldLabelStyle}" />
                                <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="14" Height="50" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Order.StatusFgBrush}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding Order.Status}"
                                            FontSize="16"
                                            FontWeight="Medium"
                                            Foreground="{Binding Order.StatusFgBrush}"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- DATE -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="DATE" Style="{StaticResource FieldLabelStyle}" />
                                <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="14" Height="50" Padding="14,0">
                                    <TextBlock Text="{Binding Order.Date}" FontSize="16" Foreground="#FF2C2118" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── RIGHT COLUMN: Products Panel (same frame as Create/Edit) ─── -->
            <Border Grid.Column="1" Background="#4DFAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Products Header -->
                    <Border Grid.Row="0" Background="#80FAF7F2" BorderBrush="#F5EDE4" BorderThickness="0,0,0,1" Padding="24,0" Height="77">
                        <TextBlock Text="Product List" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" VerticalAlignment="Center" />
                    </Border>

                    <!-- Table Column Headers -->
                    <Grid Grid.Row="1" Padding="24,12" BorderBrush="#F5EDE4" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="QTY" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="UNIT PRICE" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Product Rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{Binding Order.Products}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:OrderProductItem">
                                    <Grid Padding="24,14" BorderBrush="#F5EDE4" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="14" FontWeight="Medium" Foreground="#FF2C2118" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="14" Foreground="#CC2C2118" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding UnitPriceFormatted}" FontSize="13" Foreground="#CC2C2118" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalFormatted}" FontSize="13" FontWeight="Bold" Foreground="#FF2C2118" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Totals Footer -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#F5EDE4" BorderThickness="0,1,0,0" Padding="24,16">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Subtotal" FontSize="14" Foreground="#992C2118" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Order.SubtotalFormatted}" FontSize="14" Foreground="#FF2C2118" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Shipping Fees" FontSize="14" Foreground="#992C2118" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Order.ShippingFeeFormatted}" FontSize="14" Foreground="#FF2C2118" HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="#F5EDE4" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="Total" FontSize="18" FontWeight="Bold" Foreground="#FF2C2118" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Order.TotalAmountFormatted}" FontSize="18" FontWeight="Bold" Foreground="#F3B55C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
