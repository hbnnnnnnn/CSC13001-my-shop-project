<Page
    x:Class="CSC13001_my_shop_project.Presentation.OrderList.OrderListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.OrderList"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{StaticResource ShellBackgroundBrush}"
>
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Remove borders on focus/hover/press for TextBox -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOverFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <!-- Remove borders on focus/hover/press for ComboBox -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFBF7F2" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFF5EDE4" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFBF7F2" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#FFF3B55C" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="#FFFBF7F2" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFF8F0E5" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFF3B55C" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#26F3B55C" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#38F3B55C" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#2C2118" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ── Accent filled button (New Order) ── -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ShellAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Ghost / outline button for pagination, filters ── -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── More (⋯) action button ── -->
            <Style x:Key="MoreActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#10000000" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#18000000" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="0">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  PAGE HEADER: Title + New Order button                -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="ORDER LIST"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                    CharacterSpacing="100"
                    VerticalAlignment="Bottom"
                />

                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="4" BlurRadius="14" Spread="0" Color="#F3B55C" Opacity="0.39" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="New Order" FontSize="16" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </utu:ShadowContainer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  FILTER BAR: Search + Status dropdown + Date pickers  -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <utu:ShadowContainer Grid.Column="0">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="White"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Grid>
                            <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource ShellSearchIconBrush}" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search orders"
                                FontSize="16"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                                BorderThickness="0"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                Padding="48,12,16,12"
                                UseSystemFocusVisuals="False"
                                VerticalAlignment="Center"
                            >
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOverFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <!-- Status filter dropdown -->
                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <ComboBox
                        ItemsSource="{Binding StatusFilterOptions}"
                        SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                        Height="50"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        FontSize="14"
                        FontWeight="Medium"
                        Padding="14,0"
                        UseSystemFocusVisuals="False"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                    />
                </utu:ShadowContainer>

                <!-- From Date -->
                <utu:ShadowContainer Grid.Column="2">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="FromDateBorder"
                        Background="White"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Button
                            x:Name="FromDateButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="FromDateButton_Click"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{StaticResource ShellAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="FromDateText"
                                    Text="From Date"
                                    FontSize="14"
                                    Foreground="{StaticResource ShellTextMutedBrush}"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>
                    </Border>
                </utu:ShadowContainer>

                <!-- To Date -->
                <utu:ShadowContainer Grid.Column="3">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="ToDateBorder"
                        Background="White"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Button
                            x:Name="ToDateButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="ToDateButton_Click"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{StaticResource ShellAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ToDateText"
                                    Text="To Date"
                                    FontSize="14"
                                    Foreground="{StaticResource ShellTextMutedBrush}"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>
                    </Border>
                </utu:ShadowContainer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  DATA TABLE CARD                                      -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <utu:ShadowContainer>
                <utu:ShadowContainer.Shadows>
                    <utu:ShadowCollection>
                        <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                    </utu:ShadowCollection>
                </utu:ShadowContainer.Shadows>
                <Border
                    Background="White"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                >
                    <StackPanel>
                        <!-- ── Table Header ── -->
                        <Border
                            Background="#0CFAF7F2"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="24,20"
                            CornerRadius="16,16,0,0"
                        >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />  <!-- Order ID -->
                                    <ColumnDefinition Width="1.3*" />  <!-- Date -->
                                    <ColumnDefinition Width="2*" />    <!-- Customer Name -->
                                    <ColumnDefinition Width="1.5*" />  <!-- Order Status -->
                                    <ColumnDefinition Width="1.2*" />  <!-- Amount -->
                                    <ColumnDefinition Width="0.6*" />  <!-- Action -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ORDER ID" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="1" Text="DATE" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="2" Text="CUSTOMER NAME" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="3" Text="ORDER STATUS" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalTextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="ACTION" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalTextAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- ── Table Rows ── -->
                        <ItemsControl ItemsSource="{Binding FilteredOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="RowBorder"
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="24,0"
                                        Height="77"
                                        PointerEntered="RowBorder_PointerEntered"
                                        PointerExited="RowBorder_PointerExited"
                                    >
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="0.6*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Order ID -->
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{Binding Id}"
                                                FontSize="14" FontWeight="Medium"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Date -->
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Date}"
                                                FontSize="14"
                                                Foreground="#CC2C2118"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Customer Name -->
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding CustomerName}"
                                                FontSize="14" FontWeight="Medium"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Status Badge (Dashboard style) -->
                                            <Border
                                                Grid.Column="3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding StatusBgBrush}"
                                                BorderBrush="{Binding StatusBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="9,4"
                                            >
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    Foreground="{Binding StatusFgBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                            </Border>

                                            <!-- Amount -->
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding Amount}"
                                                FontSize="14" FontWeight="Bold"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                HorizontalTextAlignment="Right"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Action (⋯ More) -->
                                            <Button
                                                Grid.Column="5"
                                                Style="{StaticResource MoreActionButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                            >
                                                <Canvas Width="20" Height="20">
                                                    <!-- Three dots (horizontal) -->
                                                    <Ellipse Canvas.Left="2" Canvas.Top="9" Width="3" Height="3" Fill="#992C2118" />
                                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="3" Height="3" Fill="#992C2118" />
                                                    <Ellipse Canvas.Left="16" Canvas.Top="9" Width="3" Height="3" Fill="#992C2118" />
                                                </Canvas>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="View">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Edit">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Delete">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── Pagination Footer ── -->
                        <Border
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16"
                        >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Show N per page -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Show" FontSize="14" Foreground="#992C2118" VerticalAlignment="Center" />
                                    <ComboBox
                                        SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                        Width="62" Height="34"
                                        Background="{StaticResource ShellBackgroundBrush}"
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        FontSize="14"
                                        Foreground="{StaticResource ShellTextStrongBrush}"
                                    >
                                        <x:Int32>5</x:Int32>
                                        <x:Int32>10</x:Int32>
                                        <x:Int32>20</x:Int32>
                                    </ComboBox>
                                    <TextBlock Text="per page" FontSize="14" Foreground="#992C2118" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Prev / Page Numbers / Next -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding PreviousPageCommand}"
                                        Padding="8"
                                    >
                                        <TextBlock Text="Prev" FontSize="14" FontWeight="Medium" Foreground="#992C2118" />
                                    </Button>

                                    <!-- Page 1 button (active highlight) -->
                                    <utu:ShadowContainer>
                                        <utu:ShadowContainer.Shadows>
                                            <utu:ShadowCollection>
                                                <utu:Shadow OffsetX="0" OffsetY="4" BlurRadius="6" Spread="0" Color="#F3B55C" Opacity="0.2" />
                                            </utu:ShadowCollection>
                                        </utu:ShadowContainer.Shadows>
                                        <Border
                                            Background="{StaticResource ShellAccentBrush}"
                                            CornerRadius="10"
                                            Width="36" Height="36"
                                        >
                                            <TextBlock
                                                Text="1"
                                                FontSize="14" FontWeight="Bold"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                            />
                                        </Border>
                                    </utu:ShadowContainer>

                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="8" Width="36" Height="36">
                                        <TextBlock Text="2" FontSize="14" FontWeight="Medium" Foreground="{StaticResource ShellTextStrongBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="8" Width="36" Height="36">
                                        <TextBlock Text="3" FontSize="14" FontWeight="Medium" Foreground="{StaticResource ShellTextStrongBrush}" />
                                    </Button>

                                    <TextBlock Text="..." FontSize="16" Foreground="#662C2118" VerticalAlignment="Center" Margin="4,0" />

                                    <Button
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding NextPageCommand}"
                                        Padding="8"
                                    >
                                        <TextBlock Text="Next" FontSize="14" FontWeight="Medium" Foreground="#992C2118" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </utu:ShadowContainer>

        </StackPanel>
    </ScrollViewer>
</Page>
