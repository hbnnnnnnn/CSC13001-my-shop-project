<Page
    x:Class="CSC13001_my_shop_project.Presentation.OrderList.OrderListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.OrderList"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{StaticResource ShellBackgroundBrush}"
>
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Remove borders on focus/hover/press for TextBox -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOverFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <!-- Focus visual suppression -->
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ── Accent filled button (New Order) ── -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ShellAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Ghost / outline button for pagination, filters ── -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── More (⋯) action button ── -->
            <Style x:Key="MoreActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#10000000" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#18000000" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="0">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  PAGE HEADER: Title + New Order button                -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="ORDER LIST"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                    CharacterSpacing="100"
                    VerticalAlignment="Bottom"
                />

                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="4" BlurRadius="14" Spread="0" Color="#F3B55C" Opacity="0.39" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="NewOrderButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="New Order" FontSize="16" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </utu:ShadowContainer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  FILTER BAR: Search + Status dropdown + Date pickers  -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <utu:ShadowContainer Grid.Column="0">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="SearchBoxBorder"
                        Background="White"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Grid>
                            <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource ShellSearchIconBrush}" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBox
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search orders"
                            FontSize="16"
                            Foreground="{StaticResource ShellTextStrongBrush}"
                            Padding="48,12,16,12"
                            VerticalAlignment="Center"
                            UseSystemFocusVisuals="False"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus">
                            
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid Background="Transparent">
                                        <TextBlock
                                            x:Name="PlaceholderTextContentPresenter"
                                            Text="{TemplateBinding PlaceholderText}"
                                            Foreground="{StaticResource ShellTextMutedBrush}"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                            IsHitTestVisible="False" />
                                        
                                        <ScrollViewer
                                            x:Name="ContentElement"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                    </Grid>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <!-- Status filter dropdown -->
                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="White"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Button
                            x:Name="StatusFilterButton"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="16,0,12,0"
                        >
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="Padding" Value="6" />
                                            <Setter Property="MinWidth" Value="160" />
                                            <Setter Property="MaxWidth" Value="160" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <ListView
                                        x:Name="StatusFilterList"
                                        ItemsSource="{Binding StatusFilterOptions}"
                                        SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                        SelectionChanged="StatusFilterList_SelectionChanged"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        SelectionMode="Single"
                                    >
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="12,10" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Margin" Value="0,1" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{Binding}"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock
                                    x:Name="StatusFilterText"
                                    Text="{Binding SelectedStatusFilter}"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                    VerticalAlignment="Center"
                                />
                                <FontIcon
                                    Glyph="&#xE70D;"
                                    FontSize="12"
                                    Foreground="{StaticResource ShellTextMutedBrush}"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>
                    </Border>
                </utu:ShadowContainer>

                <!-- From Date -->
                <utu:ShadowContainer Grid.Column="2">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="FromDateBorder"
                        Background="White"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Button
                            x:Name="FromDateButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}"
                        >
                            <Button.Flyout>
                                <DatePickerFlyout
                                    x:Name="FromDateFlyout"
                                    DatePicked="FromDateFlyout_DatePicked"
                                />
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{StaticResource ShellAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="FromDateText"
                                    Text="From Date"
                                    FontSize="14"
                                    Foreground="{StaticResource ShellTextMutedBrush}"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>
                    </Border>
                </utu:ShadowContainer>

                <!-- To Date -->
                <utu:ShadowContainer Grid.Column="3">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="ToDateBorder"
                        Background="White"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Height="50"
                    >
                        <Button
                            x:Name="ToDateButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}"
                        >
                            <Button.Flyout>
                                <DatePickerFlyout
                                    x:Name="ToDateFlyout"
                                    DatePicked="ToDateFlyout_DatePicked"
                                />
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{StaticResource ShellAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ToDateText"
                                    Text="To Date"
                                    FontSize="14"
                                    Foreground="{StaticResource ShellTextMutedBrush}"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>
                    </Border>
                </utu:ShadowContainer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  DATA TABLE CARD                                      -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <utu:ShadowContainer>
                <utu:ShadowContainer.Shadows>
                    <utu:ShadowCollection>
                        <utu:Shadow OffsetX="0" OffsetY="1" BlurRadius="3" Spread="0" Color="#000000" Opacity="0.1" />
                    </utu:ShadowCollection>
                </utu:ShadowContainer.Shadows>
                <Border
                    Background="White"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                >
                    <StackPanel>
                        <!-- ── Table Header ── -->
                        <Border
                            Background="#0CFAF7F2"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="24,20"
                            CornerRadius="16,16,0,0"
                        >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />  <!-- Order ID -->
                                    <ColumnDefinition Width="1.3*" />  <!-- Date -->
                                    <ColumnDefinition Width="2*" />    <!-- Customer Name -->
                                    <ColumnDefinition Width="1.5*" />  <!-- Order Status -->
                                    <ColumnDefinition Width="1.2*" />  <!-- Amount -->
                                    <ColumnDefinition Width="0.6*" />  <!-- Action -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ORDER ID" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="1" Text="DATE" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="2" Text="CUSTOMER NAME" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="3" Text="ORDER STATUS" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" />
                                <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalTextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="ACTION" FontSize="12" FontWeight="Bold" Foreground="#B32C2118" CharacterSpacing="50" HorizontalTextAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- ── Table Rows ── -->
                        <ItemsControl ItemsSource="{Binding FilteredOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="RowBorder"
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="24,0"
                                        Height="77"
                                        PointerEntered="RowBorder_PointerEntered"
                                        PointerExited="RowBorder_PointerExited"
                                    >
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="0.6*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Order ID -->
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{Binding Id}"
                                                FontSize="14" FontWeight="Medium"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Date -->
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Date}"
                                                FontSize="14"
                                                Foreground="#CC2C2118"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Customer Name -->
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding CustomerName}"
                                                FontSize="14" FontWeight="Medium"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Status Badge (Dashboard style) -->
                                            <Border
                                                Grid.Column="3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding StatusBgBrush}"
                                                BorderBrush="{Binding StatusBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="9,4"
                                            >
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    Foreground="{Binding StatusFgBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                            </Border>

                                            <!-- Amount -->
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding Amount}"
                                                FontSize="14" FontWeight="Bold"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                HorizontalTextAlignment="Right"
                                                VerticalAlignment="Center"
                                            />

                                            <!-- Action (⋯ More) -->
                                            <Button
                                                Grid.Column="5"
                                                Style="{StaticResource MoreActionButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                            >
                                                <Canvas Width="20" Height="20">
                                                    <!-- Three dots (horizontal) -->
                                                    <Ellipse Canvas.Left="2" Canvas.Top="9" Width="3" Height="3" Fill="#992C2118" />
                                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="3" Height="3" Fill="#992C2118" />
                                                    <Ellipse Canvas.Left="16" Canvas.Top="9" Width="3" Height="3" Fill="#992C2118" />
                                                </Canvas>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="View" Click="ViewOrder_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Edit" Click="EditOrder_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Delete">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── Pagination Footer ── -->
                        <Border
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16"
                        >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Show N per page -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Show" FontSize="14" Foreground="#992C2118" VerticalAlignment="Center" />
                                    <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="10" Height="34" Width="62">
                                        <Button
                                            x:Name="PageSizeButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="12,0,8,0"
                                        >
                                            <Button.Flyout>
                                                <Flyout Placement="Top">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="BorderBrush" Value="#F5EDE4" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="CornerRadius" Value="10" />
                                                            <Setter Property="Padding" Value="4" />
                                                            <Setter Property="MinWidth" Value="62" />
                                                            <Setter Property="MaxWidth" Value="62" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <ListView
                                                        x:Name="PageSizeList"
                                                        SelectionChanged="PageSizeList_SelectionChanged"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        SelectionMode="Single"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    >
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="Padding" Value="6,5" />
                                                                <Setter Property="MinHeight" Value="0" />
                                                                <Setter Property="MinWidth" Value="0" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="CornerRadius" Value="8" />
                                                                <Setter Property="Margin" Value="0,1" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="Medium" Foreground="#FF2C2118" TextAlignment="Center" HorizontalAlignment="Stretch" />
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                        <x:Int32>5</x:Int32>
                                                        <x:Int32>10</x:Int32>
                                                        <x:Int32>20</x:Int32>
                                                    </ListView>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock x:Name="PageSizeText" Text="{Binding PageSize}" FontSize="14" FontWeight="Medium" Foreground="#FF2C2118" VerticalAlignment="Center" />
                                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#992C2118" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                    <TextBlock Text="per page" FontSize="14" Foreground="#992C2118" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Prev / Page Selector / Next -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding PreviousPageCommand}"
                                        Padding="8"
                                    >
                                        <TextBlock Text="Prev" FontSize="14" FontWeight="Medium" Foreground="#992C2118" />
                                    </Button>

                                    <!-- Page selector: Button + Flyout -->
                                    <Border Background="#FAF7F2" BorderBrush="#F5EDE4" BorderThickness="1" CornerRadius="10" Height="34" Width="62">
                                        <Button
                                            x:Name="PageSelectorButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="12,0,8,0"
                                        >
                                            <Button.Flyout>
                                                <Flyout Placement="Top">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="BorderBrush" Value="#F5EDE4" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="CornerRadius" Value="10" />
                                                            <Setter Property="Padding" Value="4" />
                                                            <Setter Property="MinWidth" Value="62" />
                                                            <Setter Property="MaxWidth" Value="62" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <ListView
                                                        x:Name="PageSelectorList"
                                                        ItemsSource="{Binding PageOptions}"
                                                        SelectionChanged="PageSelectorList_SelectionChanged"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        SelectionMode="Single"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    >
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="Padding" Value="6,5" />
                                                                <Setter Property="MinHeight" Value="0" />
                                                                <Setter Property="MinWidth" Value="0" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="CornerRadius" Value="8" />
                                                                <Setter Property="Margin" Value="0,1" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="Medium" Foreground="#FF2C2118" TextAlignment="Center" HorizontalAlignment="Stretch" />
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock x:Name="PageSelectorText" Text="{Binding CurrentPage}" FontSize="14" FontWeight="Medium" Foreground="#FF2C2118" VerticalAlignment="Center" />
                                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#992C2118" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Border>

                                    <Button
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding NextPageCommand}"
                                        Padding="8"
                                    >
                                        <TextBlock Text="Next" FontSize="14" FontWeight="Medium" Foreground="#992C2118" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </utu:ShadowContainer>

        </StackPanel>
    </ScrollViewer>
</Page>
