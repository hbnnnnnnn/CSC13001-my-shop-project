<Page
    x:Class="CSC13001_my_shop_project.Presentation.Login.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CSC13001_my_shop_project.Presentation.Controls"
    xmlns:converters="using:CSC13001_my_shop_project.Presentation.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AuthPanelBackgroundBrush}"
>
    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="AuthInputFocusBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="AuthInputFocusRingBrush" Color="{StaticResource BrandColor}" />
        <SolidColorBrush x:Key="AuthInputPlaceholderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="AuthPrimaryButtonHoverBrush" Color="#db860d" />
        <SolidColorBrush
            x:Key="AuthSettingsButtonHoverBackgroundBrush"
            Color="{StaticResource BrandColor}"
        />
        <SolidColorBrush x:Key="AuthSettingsButtonHoverIconBrush" Color="White" />

        <Style x:Key="AuthPrimaryButtonNoStateStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                            />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthRoundIconButtonNoStateStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                            />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AuthTextInputBrush}" />
            <Setter
                Property="PlaceholderForeground"
                Value="{StaticResource AuthInputPlaceholderBrush}"
            />
            <Setter Property="SelectionHighlightColor" Value="{StaticResource BrandColor}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <TextBlock
                                x:Name="PlaceholderTextContentPresenter"
                                Text="{TemplateBinding PlaceholderText}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                FontWeight="Thin"
                                FontSize="13"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                            />
                            <ScrollViewer
                                x:Name="ContentElement"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthFieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{StaticResource AuthTextInputBrush}" />
            <Setter
                Property="PlaceholderForeground"
                Value="{StaticResource AuthInputPlaceholderBrush}"
            />
            <Setter Property="SelectionHighlightColor" Value="{StaticResource BrandColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="PasswordRevealMode" Value="Hidden" />
        </Style>

        <Style x:Key="AuthFlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                        />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthInputIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" x:Name="LeftColumn" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" MinWidth="480" x:Name="HeroPanel">
            <Image
                Source="ms-appx:///Assets/Auth/lumina-hero.png"
                Stretch="UniformToFill"
                VerticalAlignment="Bottom"
            />
            <Rectangle Fill="{StaticResource AuthHeroOverlayBrush}" />

            <Grid Margin="40">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="22">
                    <Run Text="MY " Foreground="White" FontWeight="Bold" />
                    <Run Text="SHOP" Foreground="{StaticResource BrandColor}" FontWeight="Light" />
                </TextBlock>

                <StackPanel VerticalAlignment="Bottom" Spacing="16">
                    <TextBlock
                        Foreground="{StaticResource AuthTextOnHeroBrush}"
                        FontSize="42"
                        FontWeight="Normal"
                        Style="{x:Null}"
                        LineHeight="52"
                        CharacterSpacing="-30"
                        TextWrapping="WrapWholeWords"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                    >
                        "Crafting spaces that tell your story."
                    </TextBlock>
                    <TextBlock
                        Text="Seller Dashboard — manage your collection with ease."
                        Foreground="{StaticResource AuthTextOnHeroMutedBrush}"
                        FontSize="13"
                    />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" MinWidth="460">
            <StackPanel
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="32"
            >
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Welcome back"
                        FontSize="28"
                        LineHeight="42"
                        CharacterSpacing="-35"
                        FontWeight="Bold"
                        Style="{x:Null}"
                        Foreground="{StaticResource AuthTextStrongBrush}"
                    />
                    <TextBlock
                        Text="Sign in to your seller dashboard"
                        FontSize="14"
                        Foreground="{StaticResource AuthTextMutedBrush}"
                    />
                </StackPanel>

                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="EMAIL ADDRESS"
                            FontSize="11"
                            FontWeight="SemiBold"
                            CharacterSpacing="120"
                            Foreground="{StaticResource AuthTextLabelBrush}"
                        />
                        <Grid x:Name="EmailFieldChrome">
                            <Border
                                x:Name="EmailFieldGlow"
                                Margin="-4"
                                BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                BorderThickness="4"
                                CornerRadius="16"
                                Opacity="0"
                                IsHitTestVisible="False"
                            />

                            <Border
                                x:Name="EmailFieldSurface"
                                Height="50"
                                CornerRadius="12"
                                Background="{StaticResource AuthInputBackgroundBrush}"
                                BorderBrush="{StaticResource AuthInputBorderBrush}"
                                BorderThickness="1"
                                Padding="16,0,12,0"
                            >
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="EmailInput"
                                        Style="{StaticResource AuthFieldTextBoxStyle}"
                                        VerticalAlignment="Center"
                                        PlaceholderText="admin@myshop.com"
                                        Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Tag="Email"
                                        GotFocus="OnFieldElementGotFocus"
                                        LostFocus="OnFieldElementLostFocus"
                                    />

                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource AuthInputIconButtonStyle}"
                                        CommandParameter="{Binding ElementName=EmailInput}"
                                        Tag="Email"
                                        Click="OnClearTextClick"
                                        GotFocus="OnFieldElementGotFocus"
                                        LostFocus="OnFieldElementLostFocus"
                                        Visibility="{Binding Text, ElementName=EmailInput, Converter={StaticResource StringToVisibilityConverter}}"
                                    >
                                        <Canvas Width="16" Height="16">
                                            <Path
                                                Data="M3.5 3.5L12.5 12.5"
                                                Stroke="{StaticResource AuthTextLabelBrush}"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                            />
                                            <Path
                                                Data="M12.5 3.5L3.5 12.5"
                                                Stroke="{StaticResource AuthTextLabelBrush}"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                            />
                                        </Canvas>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="PASSWORD"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="120"
                                Foreground="{StaticResource AuthTextLabelBrush}"
                            />
                            <Button
                                Grid.Column="1"
                                Content="Forgot password?"
                                Style="{StaticResource AuthFlatButtonStyle}"
                                Foreground="{StaticResource BrandColor}"
                                FontSize="12"
                                FontWeight="Medium"
                            />
                        </Grid>

                        <Grid x:Name="PasswordFieldChrome">
                            <Border
                                x:Name="PasswordFieldGlow"
                                Margin="-4"
                                BorderBrush="{StaticResource AuthInputFocusRingBrush}"
                                BorderThickness="4"
                                CornerRadius="16"
                                Opacity="0"
                                IsHitTestVisible="False"
                            />

                            <Border
                                x:Name="PasswordFieldSurface"
                                Height="50"
                                CornerRadius="12"
                                Background="{StaticResource AuthInputBackgroundBrush}"
                                BorderBrush="{StaticResource AuthInputBorderBrush}"
                                BorderThickness="1"
                                Padding="16,0,12,0"
                            >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <PasswordBox
                                        x:Name="PasswordHiddenInput"
                                        Style="{StaticResource AuthFieldPasswordBoxStyle}"
                                        PlaceholderText="••••••••"
                                        Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                        Tag="Password"
                                        GotFocus="OnFieldElementGotFocus"
                                        LostFocus="OnFieldElementLostFocus"
                                    />

                                    <TextBox
                                        x:Name="PasswordVisibleInput"
                                        Style="{StaticResource AuthFieldTextBoxStyle}"
                                        PlaceholderText="••••••••"
                                        Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Tag="Password"
                                        GotFocus="OnFieldElementGotFocus"
                                        LostFocus="OnFieldElementLostFocus"
                                    />

                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource AuthInputIconButtonStyle}"
                                        Tag="Password"
                                        Click="OnTogglePasswordVisibilityClick"
                                        GotFocus="OnFieldElementGotFocus"
                                        LostFocus="OnFieldElementLostFocus"
                                    >
                                        <Grid Width="16" Height="16">
                                            <Canvas
                                                Width="14"
                                                Height="10"
                                                Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                            >
                                                <Path
                                                    Data="M0.708337 5.56492C0.652777 5.41525 0.652777 5.2506 0.708337 5.10092C1.24947 3.78883 2.16801 2.66695 3.34752 1.87752C4.52702 1.08809 5.91437 0.666667 7.33367 0.666667C8.75297 0.666667 10.1403 1.08809 11.3198 1.87752C12.4993 2.66695 13.4179 3.78883 13.959 5.10092C14.0146 5.2506 14.0146 5.41525 13.959 5.56492C13.4179 6.87702 12.4993 7.9989 11.3198 8.78832C10.1403 9.57775 8.75297 9.99918 7.33367 9.99918C5.91437 9.99918 4.52702 9.57775 3.34752 8.78832C2.16801 7.9989 1.24947 6.87702 0.708337 5.56492Z"
                                                    Stroke="{StaticResource AuthTextInputBrush}"
                                                    StrokeThickness="1.33"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                />
                                                <Path
                                                    Data="M2.66667 4.66667C3.77124 4.66667 4.66667 3.77124 4.66667 2.66667C4.66667 1.5621 3.77124 0.666667 2.66667 0.666667C1.5621 0.666667 0.666667 1.5621 0.666667 2.66667C0.666667 3.77124 1.5621 4.66667 2.66667 4.66667Z"
                                                    Stroke="{StaticResource AuthTextInputBrush}"
                                                    StrokeThickness="1.33"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    RenderTransformOrigin="0,0"
                                                >
                                                    <Path.RenderTransform>
                                                        <TranslateTransform X="4.667" Y="2.667" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Canvas>

                                            <Canvas
                                                Width="14"
                                                Height="10"
                                                Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            >
                                                <Path
                                                    Data="M0.708337 5.56492C0.652777 5.41525 0.652777 5.2506 0.708337 5.10092C1.24947 3.78883 2.16801 2.66695 3.34752 1.87752C4.52702 1.08809 5.91437 0.666667 7.33367 0.666667C8.75297 0.666667 10.1403 1.08809 11.3198 1.87752C12.4993 2.66695 13.4179 3.78883 13.959 5.10092C14.0146 5.2506 14.0146 5.41525 13.959 5.56492C13.4179 6.87702 12.4993 7.9989 11.3198 8.78832C10.1403 9.57775 8.75297 9.99918 7.33367 9.99918C5.91437 9.99918 4.52702 9.57775 3.34752 8.78832C2.16801 7.9989 1.24947 6.87702 0.708337 5.56492Z"
                                                    Stroke="{StaticResource AuthTextInputBrush}"
                                                    StrokeThickness="1.33"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                />
                                                <Path
                                                    Data="M1.2 9.2L12.8 0.8"
                                                    Stroke="{StaticResource AuthTextInputBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                />
                                            </Canvas>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border
                        Margin="0,12,0,0"
                        Background="#FEF2F2"
                        BorderBrush="#F87171"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    >
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" />
                        </TextBlock>
                    </Border>

                    <controls:CustomCheckBox
                        Content="Remember me"
                        IsChecked="{Binding RememberMe, Mode=TwoWay}"
                    />

                    <Button
                        x:Name="SignInButton"
                        Style="{StaticResource AuthPrimaryButtonNoStateStyle}"
                        Height="50"
                        Command="{Binding SignIn}"
                        Background="{StaticResource AuthPrimaryButtonBrush}"
                        PointerEntered="OnSignInPointerEntered"
                        PointerExited="OnSignInPointerExited"
                        PointerCanceled="OnSignInPointerExited"
                    >
                        <Grid HorizontalAlignment="Center" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="Sign in"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                            <Canvas
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                            >
                                <Path
                                    Data="M3.33331 8H12.6666"
                                    Stroke="White"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                />
                                <Path
                                    Data="M8 3.3335L12.6667 8.00016L8 12.6668"
                                    Stroke="White"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                />
                            </Canvas>
                        </Grid>
                    </Button>
                </StackPanel>

                <TextBlock
                    Text="Version 1.0.0"
                    FontSize="12"
                    Foreground="{StaticResource AuthTextInputBrush}"
                    HorizontalAlignment="Center"
                />
            </StackPanel>

            <!-- Settings Button -->
            <Button
                x:Name="ConfigurationButton"
                Style="{StaticResource AuthRoundIconButtonNoStateStyle}"
                Width="48"
                Height="48"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{StaticResource AuthSettingsButtonBackgroundBrush}"
                BorderBrush="#40F3B55C"
                BorderThickness="1"
                CornerRadius="999"
                Command="{Binding GoToServerConfiguration}"
                PointerEntered="OnConfigurationButtonPointerEntered"
                PointerExited="OnConfigurationButtonPointerExited"
                PointerCanceled="OnConfigurationButtonPointerExited"
            >
                <Canvas Width="20" Height="20">
                    <Path
                        x:Name="ConfigurationButtonOuterIcon"
                        Data="M10.1833 1.66667H9.81667C9.37464 1.66667 8.95072 1.84226 8.63816 2.15482C8.32559 2.46738 8.15 2.89131 8.15 3.33333V3.48333C8.1497 3.7756 8.07255 4.06266 7.92628 4.3157C7.78002 4.56874 7.56978 4.77886 7.31667 4.925L6.95833 5.13333C6.70497 5.27961 6.41756 5.35662 6.125 5.35662C5.83244 5.35662 5.54503 5.27961 5.29167 5.13333L5.16667 5.06667C4.78422 4.84605 4.32986 4.7862 3.90334 4.90026C3.47681 5.01431 3.11296 5.29295 2.89167 5.675L2.70833 5.99167C2.48772 6.37411 2.42787 6.82847 2.54192 7.255C2.65598 7.68153 2.93461 8.04537 3.31667 8.26667L3.44167 8.35C3.69356 8.49543 3.90302 8.70424 4.04921 8.95569C4.1954 9.20714 4.27324 9.49248 4.275 9.78333V10.2083C4.27617 10.502 4.19971 10.7908 4.05337 11.0454C3.90703 11.3001 3.69601 11.5115 3.44167 11.6583L3.31667 11.7333C2.93461 11.9546 2.65598 12.3185 2.54192 12.745C2.42787 13.1715 2.48772 13.6259 2.70833 14.0083L2.89167 14.325C3.11296 14.7071 3.47681 14.9857 3.90334 15.0997C4.32986 15.2138 4.78422 15.1539 5.16667 14.9333L5.29167 14.8667C5.54503 14.7204 5.83244 14.6434 6.125 14.6434C6.41756 14.6434 6.70497 14.7204 6.95833 14.8667L7.31667 15.075C7.56978 15.2211 7.78002 15.4313 7.92628 15.6843C8.07255 15.9373 8.1497 16.2244 8.15 16.5167V16.6667C8.15 17.1087 8.32559 17.5326 8.63816 17.8452C8.95072 18.1577 9.37464 18.3333 9.81667 18.3333H10.1833C10.6254 18.3333 11.0493 18.1577 11.3618 17.8452C11.6744 17.5326 11.85 17.1087 11.85 16.6667V16.5167C11.8503 16.2244 11.9275 15.9373 12.0737 15.6843C12.22 15.4313 12.4302 15.2211 12.6833 15.075L13.0417 14.8667C13.295 14.7204 13.5824 14.6434 13.875 14.6434C14.1676 14.6434 14.455 14.7204 14.7083 14.8667L14.8333 14.9333C15.2158 15.1539 15.6701 15.2138 16.0967 15.0997C16.5232 14.9857 16.887 14.7071 17.1083 14.325L17.2917 14C17.5123 13.6176 17.5721 13.1632 17.4581 12.7367C17.344 12.3101 17.0654 11.9463 16.6833 11.725L16.5583 11.6583C16.304 11.5115 16.093 11.3001 15.9466 11.0454C15.8003 10.7908 15.7238 10.502 15.725 10.2083V9.79167C15.7238 9.49798 15.8003 9.20921 15.9466 8.95458C16.093 8.69995 16.304 8.48851 16.5583 8.34167L16.6833 8.26667C17.0654 8.04537 17.344 7.68153 17.4581 7.255C17.5721 6.82847 17.5123 6.37411 17.2917 5.99167L17.1083 5.675C16.887 5.29295 16.5232 5.01431 16.0967 4.90026C15.6701 4.7862 15.2158 4.84605 14.8333 5.06667L14.7083 5.13333C14.455 5.27961 14.1676 5.35662 13.875 5.35662C13.5824 5.35662 13.295 5.27961 13.0417 5.13333L12.6833 4.925C12.4302 4.77886 12.22 4.56874 12.0737 4.3157C11.9275 4.06266 11.8503 3.7756 11.85 3.48333V3.33333C11.85 2.89131 11.6744 2.46738 11.3618 2.15482C11.0493 1.84226 10.6254 1.66667 10.1833 1.66667Z"
                        Stroke="{StaticResource BrandColor}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                    />
                    <Path
                        x:Name="ConfigurationButtonInnerIcon"
                        Data="M10 12.5C11.3807 12.5 12.5 11.3807 12.5 10C12.5 8.61929 11.3807 7.5 10 7.5C8.61929 7.5 7.5 8.61929 7.5 10C7.5 11.3807 8.61929 12.5 10 12.5Z"
                        Stroke="{StaticResource BrandColor}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                    />
                </Canvas>
            </Button>
        </Grid>
    </Grid>
</Page>
