<Page
    x:Class="CSC13001_my_shop_project.Presentation.Reports.ReportPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.Reports"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:CSC13001_my_shop_project.Presentation.Converters"
    xmlns:prodconv="using:CSC13001_my_shop_project.Presentation.Products.Converters"
    Background="{StaticResource ShellBackgroundBrush}"
    Loaded="ReportPage_OnLoaded"
>
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToLegendOpacityConverter x:Key="LegendOpacityConverter" />
        <prodconv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <!-- Fills filter row height; avoids Material default hover ripple extending past the field -->
        <Style x:Key="ReportFilterDateFlyoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                        >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#33F3B55C" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#4DF3B55C" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ChartSeriesLegendItemTemplate">
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                Padding="6,4"
                CornerRadius="4"
                Opacity="{Binding IsVisibleInChart, Converter={StaticResource LegendOpacityConverter}}"
                Command="{Binding DataContext.ToggleSeriesVisibilityCommand, ElementName=ThisPage}"
                CommandParameter="{Binding}"
            >
                <TextBlock
                    Text="{Binding DisplayName}"
                    TextWrapping="WrapWholeWords"
                    FontSize="11"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                />
            </Button>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    Text="REPORTS"
                    FontSize="28"
                    FontWeight="ExtraBold"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                    CharacterSpacing="50"
                />
                <!-- <TextBlock
                    Text="Delivered orders only. Default date range is 1 Jan 2026 – 31 Dec 2026 (UTC). The second column is units sold (not profit). Revenue from the API is in VND (₫). Click a legend item next to a chart to show or hide that series. After seeding the database, click Apply; if the API uses Redis cache, restart it when numbers look stale."
                    FontSize="14"
                    Foreground="#FF6B7280"
                    TextWrapping="WrapWholeWords"
                /> -->
            </StackPanel>

            <Border
                Padding="16"
                Background="#0FFFFFFF"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
            >
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Filters"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                    />
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="From" FontSize="13" Foreground="#FF6B7280" />
                            <Border
                                Height="36"
                                MinHeight="36"
                                MaxHeight="36"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                            >
                                <Button Style="{StaticResource ReportFilterDateFlyoutButtonStyle}">
                                    <Button.Flyout>
                                        <DatePickerFlyout Date="{Binding StartDate, Mode=TwoWay}" />
                                    </Button.Flyout>
                                    <TextBlock
                                        Text="{Binding StartDateDisplay}"
                                        FontSize="14"
                                        Foreground="{StaticResource ShellTextStrongBrush}"
                                        TextAlignment="Left"
                                        VerticalAlignment="Center"
                                    />
                                </Button>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="To" FontSize="13" Foreground="#FF6B7280" />
                            <Border
                                Height="36"
                                MinHeight="36"
                                MaxHeight="36"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                            >
                                <Button Style="{StaticResource ReportFilterDateFlyoutButtonStyle}">
                                    <Button.Flyout>
                                        <DatePickerFlyout Date="{Binding EndDate, Mode=TwoWay}" />
                                    </Button.Flyout>
                                    <TextBlock
                                        Text="{Binding EndDateDisplay}"
                                        FontSize="14"
                                        Foreground="{StaticResource ShellTextStrongBrush}"
                                        TextAlignment="Left"
                                        VerticalAlignment="Center"
                                    />
                                </Button>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Period" FontSize="13" Foreground="#FF6B7280" />
                            <ComboBox
                                ItemsSource="{Binding PeriodOptions}"
                                DisplayMemberPath="Label"
                                SelectedValuePath="Key"
                                SelectedValue="{Binding SelectedPeriodKey, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Height="36"
                                MinHeight="36"
                                MaxHeight="36"
                                FontSize="14"
                                Padding="10,0,8,0"
                                VerticalContentAlignment="Center"
                            />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Bottom"
                            Height="36"
                            MinHeight="36"
                            MaxHeight="36"
                            Padding="18,0"
                            FontSize="14"
                            Content="Apply"
                            Background="{StaticResource ShellAccentBrush}"
                            Foreground="White"
                            Command="{Binding RefreshCommand}"
                        />
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid ColumnSpacing="14" MinWidth="1020">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="20,16"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                    >
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Total orders"
                                FontSize="13"
                                Foreground="#FF6B7280"
                                TextWrapping="WrapWholeWords"
                            />
                            <TextBlock
                                Text="{Binding OverviewTotalOrders}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="20,16"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                    >
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Total revenue"
                                FontSize="13"
                                Foreground="#FF6B7280"
                                TextWrapping="WrapWholeWords"
                            />
                            <TextBlock
                                Text="{Binding OverviewTotalRevenue}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="20,16"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                    >
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Items sold"
                                FontSize="13"
                                Foreground="#FF6B7280"
                                TextWrapping="WrapWholeWords"
                            />
                            <TextBlock
                                Text="{Binding OverviewTotalItemsSold}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="3"
                        Padding="20,16"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                    >
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Avg order value"
                                FontSize="13"
                                Foreground="#FF6B7280"
                                TextWrapping="WrapWholeWords"
                            />
                            <TextBlock
                                Text="{Binding OverviewAvgOrderValue}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="4"
                        Padding="20,16"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                    >
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Max order value"
                                FontSize="13"
                                Foreground="#FF6B7280"
                                TextWrapping="WrapWholeWords"
                            />
                            <TextBlock
                                Text="{Binding OverviewMaxOrderValue}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="5"
                        Padding="20,16"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                    >
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Min order value"
                                FontSize="13"
                                Foreground="#FF6B7280"
                                TextWrapping="WrapWholeWords"
                            />
                            <TextBlock
                                Text="{Binding OverviewMinOrderValue}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="#FFDC2626"
                TextWrapping="Wrap"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
            />

            <ProgressRing
                Width="40"
                Height="40"
                IsActive="{Binding IsBusy}"
                HorizontalAlignment="Left"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            />

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding LineChartTitle}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                    />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                    >
                        <TextBlock
                            Text="View"
                            FontSize="12"
                            Foreground="#FF6B7280"
                            VerticalAlignment="Center"
                        />
                        <ComboBox
                            ItemsSource="{Binding LineModeOptions}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Key"
                            SelectedValue="{Binding SelectedLineModeKey, Mode=TwoWay}"
                            MinWidth="140"
                            Height="32"
                            FontSize="13"
                            Padding="10,0,8,0"
                            VerticalContentAlignment="Center"
                        />
                        <TextBlock
                            Text="Category"
                            FontSize="12"
                            Foreground="#FF6B7280"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsProductMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        />
                        <ComboBox
                            ItemsSource="{Binding CategoryOptions}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Id"
                            SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                            MinWidth="180"
                            Height="32"
                            FontSize="13"
                            Padding="10,0,8,0"
                            VerticalContentAlignment="Center"
                            Visibility="{Binding IsProductMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        />
                    </StackPanel>
                </Grid>
                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="{Binding IsDrilldownBusy}"
                    HorizontalAlignment="Left"
                    Visibility="{Binding IsDrilldownBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="168" MaxWidth="220" />
                    </Grid.ColumnDefinitions>
                    <lvc:CartesianChart
                        Grid.Column="0"
                        Series="{Binding SalesLineSeries}"
                        XAxes="{Binding SalesLineXAxes}"
                        YAxes="{Binding SalesLineYAxes}"
                        Height="320"
                        LegendPosition="Hidden"
                        TooltipTextSize="11"
                    />
                    <Border
                        Grid.Column="1"
                        Padding="4,0,0,0"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1,0,0,0"
                    >
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemTemplate="{StaticResource ChartSeriesLegendItemTemplate}"
                                ItemsSource="{Binding SalesLineLegendItems}"
                            />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    Text="Revenue"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="168" MaxWidth="220" />
                    </Grid.ColumnDefinitions>
                    <lvc:CartesianChart
                        Grid.Column="0"
                        Series="{Binding RevenueColumnSeries}"
                        XAxes="{Binding RevenueXAxes}"
                        YAxes="{Binding RevenueYAxes}"
                        Height="320"
                        LegendPosition="Hidden"
                        TooltipTextSize="11"
                    />
                    <Border
                        Grid.Column="1"
                        Padding="4,0,0,0"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1,0,0,0"
                    >
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemTemplate="{StaticResource ChartSeriesLegendItemTemplate}"
                                ItemsSource="{Binding RevenueLegendItems}"
                            />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                    <TextBlock
                        Text="Top products — revenue share"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                    />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="140" MaxWidth="200" />
                        </Grid.ColumnDefinitions>
                        <lvc:PieChart
                            Grid.Column="0"
                            Series="{Binding PieTopProductsSeries}"
                            Height="280"
                            LegendPosition="Hidden"
                            TooltipTextSize="11"
                        />
                        <Border
                            Grid.Column="1"
                            Padding="4,0,0,0"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1,0,0,0"
                        >
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemTemplate="{StaticResource ChartSeriesLegendItemTemplate}"
                                    ItemsSource="{Binding PieTopLegendItems}"
                                />
                            </ScrollViewer>
                        </Border>
                    </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
