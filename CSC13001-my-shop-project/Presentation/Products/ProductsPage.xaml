<Page
    x:Class="CSC13001_my_shop_project.Presentation.Products.ProductsPage"
    x:Name="ProductsRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:products="using:CSC13001_my_shop_project.Presentation.Products"
    xmlns:utu="using:Uno.Toolkit.UI"
    NavigationCacheMode="Required"
    Background="{StaticResource ShellBackgroundBrush}"
>
    <Page.Resources>
        <products:BoolToVisibilityConverter x:Key="BoolToVis" />
        <products:BoolToToggleChromeBackgroundConverter x:Key="BoolToToggleBg" />
        <products:PaginationNumberBackgroundConverter x:Key="PagBg" />
        <products:PaginationNumberForegroundConverter x:Key="PagFg" />

        <Style x:Key="ProductsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ShellAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="ProductsIconGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="ProductsPaginationChevronStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="0">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="ALL PRODUCTS"
                        FontSize="28"
                        FontWeight="ExtraBold"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                        CharacterSpacing="50"
                    />
                    <TextBlock
                        Text="Manage and organize your product catalog"
                        FontSize="15"
                        Foreground="#FF6B7280"
                    />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource ProductsPrimaryButtonStyle}"
                    Command="{Binding AddNewProductCommand}"
                >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE710;"
                            FontSize="16"
                            Foreground="White"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Text="Add New Product" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stat cards -->
            <Grid ColumnSpacing="20" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <utu:ShadowContainer Grid.Column="0">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Total Products" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding TotalProductsStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFF5EDE4"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE7B8;"
                                    FontSize="22"
                                    Foreground="{StaticResource ShellAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Active" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding ActiveStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFECFDF5"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE73E;"
                                    FontSize="22"
                                    Foreground="#FF16A34A"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <utu:ShadowContainer Grid.Column="2">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Out of Stock" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding OutOfStockStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFFEF2F2"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE711;"
                                    FontSize="20"
                                    Foreground="#FFEF4444"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <utu:ShadowContainer Grid.Column="3">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Low Stock" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding LowStockStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFFFFBEB"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE7BA;"
                                    FontSize="20"
                                    Foreground="#FFF59E0B"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>
            </Grid>

            <!-- Toolbar -->
            <Border
                Background="#FFFFFFFF"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,0,0,20"
            >
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Height="44" VerticalAlignment="Center">
                        <TextBox
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search products..."
                            CornerRadius="22"
                            Padding="44,10,16,10"
                            BorderThickness="0"
                            Background="#80F5EDE4"
                            Foreground="{StaticResource ShellTextStrongBrush}"
                            VerticalContentAlignment="Center"
                        />
                        <Viewbox
                            Width="18"
                            Height="18"
                            Margin="16,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                        >
                            <Canvas Width="18" Height="18">
                                <Path
                                    Data="M8.25 14.25C11.5637 14.25 14.25 11.5637 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25Z"
                                    Stroke="#662C2118"
                                    StrokeThickness="1.5"
                                />
                                <Path
                                    Data="M15.75 15.7504L12.525 12.5254"
                                    Stroke="#662C2118"
                                    StrokeThickness="1.5"
                                />
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        PlaceholderText="Category"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                    />
                    <ComboBox
                        Grid.Column="2"
                        ItemsSource="{Binding StatusFilterOptions}"
                        SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                        PlaceholderText="Status"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                    />
                    <ComboBox
                        Grid.Column="3"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                        PlaceholderText="Sort"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                    />

                    <StackPanel
                        Grid.Column="4"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                    >
                        <Border
                            CornerRadius="8"
                            Background="{Binding IsGridView, Converter={StaticResource BoolToToggleBg}}"
                        >
                            <Button
                                Style="{StaticResource ProductsIconGhostButtonStyle}"
                                Command="{Binding ToggleGridViewCommand}"
                                AutomationProperties.Name="Grid view"
                            >
                                <FontIcon Glyph="&#xE80A;" FontSize="18" Foreground="{StaticResource ShellTextStrongBrush}" />
                            </Button>
                        </Border>
                        <Border
                            CornerRadius="8"
                            Background="{Binding IsGridView, Converter={StaticResource BoolToToggleBg}, ConverterParameter=invert}"
                        >
                            <Button
                                Style="{StaticResource ProductsIconGhostButtonStyle}"
                                Command="{Binding ToggleListViewCommand}"
                                AutomationProperties.Name="List view"
                            >
                                <FontIcon Glyph="&#xE8FD;" FontSize="18" Foreground="{StaticResource ShellTextStrongBrush}" />
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid view -->
            <GridView
                ItemsSource="{Binding PagedItems}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,8"
            >
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <utu:ShadowContainer Width="260" Height="408" Margin="0,0,12,16">
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="4"
                                        BlurRadius="12"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.06"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                            >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Border CornerRadius="12,12,0,0" Background="{StaticResource ShellAvatarSoftBrush}" />
                                        <Border CornerRadius="12,12,0,0">
                                            <Image
                                                Source="{Binding Thumbnail}"
                                                Stretch="UniformToFill"
                                            />
                                        </Border>
                                        <Border
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12,12,0,0"
                                            Background="{Binding StatusBadgeBg}"
                                            BorderBrush="{Binding StatusBadgeFg}"
                                            BorderThickness="1"
                                            CornerRadius="20"
                                            Padding="10,4"
                                        >
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding StatusDotBrush}"
                                                />
                                                <TextBlock
                                                    Text="{Binding StatusLabel}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding StatusBadgeFg}"
                                                    VerticalAlignment="Center"
                                                />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="1"
                                        Padding="16,14,16,16"
                                        Spacing="6"
                                    >
                                        <TextBlock
                                            Text="{Binding CategorySkuLine}"
                                            FontSize="11"
                                            Foreground="#FF9CA3AF"
                                        />
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ShellTextStrongBrush}"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                        />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Text="&#x2605;"
                                                FontSize="14"
                                                Foreground="#FFFBBF24"
                                                VerticalAlignment="Center"
                                            />
                                            <TextBlock
                                                Text="{Binding RatingText}"
                                                FontSize="13"
                                                Foreground="#FF6B7280"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding PriceText}"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                                <TextBlock
                                                    Text="{Binding CompareAtText}"
                                                    FontSize="14"
                                                    Foreground="#FF9CA3AF"
                                                    VerticalAlignment="Center"
                                                    TextDecorations="Strikethrough"
                                                    Visibility="{Binding ShowCompareAt, Converter={StaticResource BoolToVis}}"
                                                />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding StockText}"
                                                FontSize="12"
                                                Foreground="#FF9CA3AF"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                            />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- List view -->
            <ItemsControl
                ItemsSource="{Binding PagedItems}"
                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                Margin="0,0,0,8"
            >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <utu:ShadowContainer Margin="0,0,0,12">
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="2"
                                        BlurRadius="10"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.05"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                PointerEntered="ProductRow_PointerEntered"
                                PointerExited="ProductRow_PointerExited"
                            >
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="88"
                                        Height="88"
                                        CornerRadius="10"
                                        Background="{StaticResource ShellAvatarSoftBrush}"
                                    >
                                        <Border CornerRadius="10">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding CategorySkuLine}"
                                                FontSize="11"
                                                Foreground="#FF9CA3AF"
                                                VerticalAlignment="Center"
                                            />
                                            <Border
                                                Background="{Binding StatusBadgeBg}"
                                                BorderBrush="{Binding StatusBadgeFg}"
                                                BorderThickness="1"
                                                CornerRadius="20"
                                                Padding="8,3"
                                            >
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        Fill="{Binding StatusDotBrush}"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding StatusLabel}"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding StatusBadgeFg}"
                                                    />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ShellTextStrongBrush}"
                                        />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="&#x2605;" FontSize="13" Foreground="#FFFBBF24" />
                                            <TextBlock
                                                Text="{Binding RatingText}"
                                                FontSize="13"
                                                Foreground="#FF6B7280"
                                            />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding PriceText}"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                            />
                                            <TextBlock
                                                Text="{Binding CompareAtText}"
                                                FontSize="13"
                                                Foreground="#FF9CA3AF"
                                                TextDecorations="Strikethrough"
                                                Visibility="{Binding ShowCompareAt, Converter={StaticResource BoolToVis}}"
                                            />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding StockText}"
                                        FontSize="13"
                                        Foreground="#FF9CA3AF"
                                        VerticalAlignment="Center"
                                    />
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pagination -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{Binding PageSummaryText}"
                    FontSize="14"
                    Foreground="#FF6B7280"
                    VerticalAlignment="Center"
                />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                >
                    <Button
                        Style="{StaticResource ProductsPaginationChevronStyle}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                    >
                        <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="{StaticResource ShellTextStrongBrush}" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="40"
                                    Height="40"
                                    CornerRadius="8"
                                    Padding="0"
                                    Background="{Binding IsCurrent, Converter={StaticResource PagBg}}"
                                    Foreground="{Binding IsCurrent, Converter={StaticResource PagFg}}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    Command="{Binding DataContext.GoToPageCommand, ElementName=ProductsRootPage}"
                                    CommandParameter="{Binding Page}"
                                    UseSystemFocusVisuals="False"
                                >
                                    <TextBlock
                                        Text="{Binding Page}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Style="{StaticResource ProductsPaginationChevronStyle}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                    >
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource ShellTextStrongBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
