<Page
    x:Class="CSC13001_my_shop_project.Presentation.Products.ProductsPage"
    x:Name="ProductsRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:products="using:CSC13001_my_shop_project.Presentation.Products"
    xmlns:utu="using:Uno.Toolkit.UI"
    NavigationCacheMode="Required"
    Background="{StaticResource ShellBackgroundBrush}"
>
    <Page.Resources>
        <products:BoolToVisibilityConverter x:Key="BoolToVis" />
        <products:BoolToToggleChromeBackgroundConverter x:Key="BoolToToggleBg" />
        <products:ViewModeSegmentIconBrushConverter x:Key="ViewModeIconFg" />
        <products:PaginationNumberBackgroundConverter x:Key="PagBg" />
        <products:PaginationNumberForegroundConverter x:Key="PagFg" />

        <SolidColorBrush x:Key="ProductCardSurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ProductCardHoverBackgroundBrush" Color="#FFF5EDE4" />
        <SolidColorBrush x:Key="ProductCardHoverBorderBrush" Color="#99F3B55C" />

        <Style x:Key="ProductsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ShellAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="ProductsIconGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="ProductsViewSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="FilterDropdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#80F5EDE4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0"
                        >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#B0F0E4D8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#C0EDE0D4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductsPaginationChevronStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <!-- No ListViewItemPresenter / reveal border (avoids extra grey ring around cards). -->
        <Style x:Key="ProductsGridViewItemChromelessStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="0">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="ALL PRODUCTS"
                        FontSize="28"
                        FontWeight="ExtraBold"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                        CharacterSpacing="50"
                    />
                    <TextBlock
                        Text="Manage and organize your product catalog"
                        FontSize="15"
                        Foreground="#FF6B7280"
                    />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource ProductsPrimaryButtonStyle}"
                    Command="{Binding AddNewProductCommand}"
                >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE710;"
                            FontSize="16"
                            Foreground="White"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Text="Add New Product" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stat cards -->
            <Grid ColumnSpacing="20" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <utu:ShadowContainer Grid.Column="0">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Total Products" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding TotalProductsStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFF5EDE4"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE7B8;"
                                    FontSize="22"
                                    Foreground="{StaticResource ShellAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Active" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding ActiveStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFECFDF5"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE73E;"
                                    FontSize="22"
                                    Foreground="#FF16A34A"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <utu:ShadowContainer Grid.Column="2">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Out of Stock" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding OutOfStockStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFFEF2F2"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE711;"
                                    FontSize="20"
                                    Foreground="#FFEF4444"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <utu:ShadowContainer Grid.Column="3">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="108"
                    >
                        <Grid Padding="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Low Stock" FontSize="13" Foreground="#FF9CA3AF" />
                                <TextBlock
                                    Text="{Binding LowStockStat}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="#FFFFFBEB"
                                VerticalAlignment="Center"
                            >
                                <FontIcon
                                    Glyph="&#xE7BA;"
                                    FontSize="20"
                                    Foreground="#FFF59E0B"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>
            </Grid>

            <!-- Toolbar -->
            <Border
                Background="#FFFFFFFF"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,0,0,20"
            >
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        MinWidth="360"
                        Height="44"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                    >
                        <TextBox
                            Style="{StaticResource ShellSearchTextBoxStyle}"
                            CornerRadius="10"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search products..."
                            PlaceholderForeground="{StaticResource ShellSearchTextBrush}"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus"
                        >
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#80F5EDE4" />
                                <SolidColorBrush
                                    x:Key="TextControlBackgroundPointerOver"
                                    Color="#80F5EDE4"
                                />
                                <SolidColorBrush
                                    x:Key="TextControlSelectionHighlightColor"
                                    Color="#CC2C2118"
                                />
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF2C2118" />
                                <SolidColorBrush x:Key="TextControlCaretBrush" Color="#FF2C2118" />
                                <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>

                        <Border
                            x:Name="ToolbarSearchFocusRing"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            IsHitTestVisible="False"
                        />

                        <Viewbox
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="16,0,0,0"
                            IsHitTestVisible="False"
                        >
                            <Canvas Width="18" Height="18">
                                <Path
                                    Data="M8.25 14.25C11.5637 14.25 14.25 11.5637 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25Z"
                                    Stroke="{StaticResource ShellSearchIconBrush}"
                                    StrokeThickness="1.5"
                                />
                                <Path
                                    Data="M15.75 15.7504L12.525 12.5254"
                                    Stroke="{StaticResource ShellSearchIconBrush}"
                                    StrokeThickness="1.5"
                                />
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- Category filter -->
                    <Button
                        Grid.Column="1"
                        Height="44"
                        VerticalAlignment="Center"
                        Style="{StaticResource FilterDropdownButtonStyle}"
                    >
                        <Button.Flyout>
                            <MenuFlyout x:Name="CategoryMenuFlyout" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="13" Foreground="#992C2118" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedCategory}" FontSize="14" Foreground="#FF2C2118" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#992C2118" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Status filter -->
                    <Button
                        Grid.Column="2"
                        Height="44"
                        VerticalAlignment="Center"
                        Style="{StaticResource FilterDropdownButtonStyle}"
                    >
                        <Button.Flyout>
                            <MenuFlyout x:Name="StatusMenuFlyout" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SelectedStatusFilter}" FontSize="14" Foreground="#FF2C2118" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#992C2118" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Sort filter -->
                    <Button
                        Grid.Column="3"
                        Height="44"
                        VerticalAlignment="Center"
                        Style="{StaticResource FilterDropdownButtonStyle}"
                    >
                        <Button.Flyout>
                            <MenuFlyout x:Name="SortMenuFlyout" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="13" Foreground="#992C2118" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedSort}" FontSize="14" Foreground="#FF2C2118" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#992C2118" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Background="#FFF9F7F2"
                        CornerRadius="10"
                        Padding="5,4,5,4"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Grid Width="40" Height="32" VerticalAlignment="Center">
                                <utu:ShadowContainer Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                                    <utu:ShadowContainer.Shadows>
                                        <utu:ShadowCollection>
                                            <utu:Shadow
                                                OffsetX="0"
                                                OffsetY="2"
                                                BlurRadius="8"
                                                Spread="0"
                                                Color="#000000"
                                                Opacity="0.12"
                                            />
                                        </utu:ShadowCollection>
                                    </utu:ShadowContainer.Shadows>
                                    <Border Background="#FFFFFFFF" CornerRadius="8" />
                                </utu:ShadowContainer>
                                <Button
                                    Style="{StaticResource ProductsViewSegmentButtonStyle}"
                                    Command="{Binding ToggleGridViewCommand}"
                                    AutomationProperties.Name="Grid view"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                >
                                    <FontIcon
                                        Glyph="&#xE80A;"
                                        FontSize="18"
                                        Foreground="{Binding IsGridView, Converter={StaticResource ViewModeIconFg}, ConverterParameter=grid}"
                                    />
                                </Button>
                            </Grid>
                            <Grid Width="40" Height="32" VerticalAlignment="Center">
                                <utu:ShadowContainer Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <utu:ShadowContainer.Shadows>
                                        <utu:ShadowCollection>
                                            <utu:Shadow
                                                OffsetX="0"
                                                OffsetY="2"
                                                BlurRadius="8"
                                                Spread="0"
                                                Color="#000000"
                                                Opacity="0.12"
                                            />
                                        </utu:ShadowCollection>
                                    </utu:ShadowContainer.Shadows>
                                    <Border Background="#FFFFFFFF" CornerRadius="8" />
                                </utu:ShadowContainer>
                                <Button
                                    Style="{StaticResource ProductsViewSegmentButtonStyle}"
                                    Command="{Binding ToggleListViewCommand}"
                                    AutomationProperties.Name="List view"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                >
                                    <FontIcon
                                        Glyph="&#xE8FD;"
                                        FontSize="18"
                                        Foreground="{Binding IsGridView, Converter={StaticResource ViewModeIconFg}, ConverterParameter=list}"
                                    />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Grid view: tile width from page (four columns, fills available width) -->
            <GridView
                x:Name="ProductsGridView"
                ItemsSource="{Binding PagedItems}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                SizeChanged="ProductsGridView_SizeChanged"
                ItemContainerStyle="{StaticResource ProductsGridViewItemChromelessStyle}"
            >
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <utu:ShadowContainer
                            Width="{Binding ProductGridTileWidth, ElementName=ProductsRootPage}"
                            Height="408"
                            Margin="0"
                        >
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <!-- Ambient only: downward offset reads as a second grey line under the card. -->
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="0"
                                        BlurRadius="14"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.05"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="{StaticResource ProductCardSurfaceBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5"
                                PointerEntered="ProductRow_PointerEntered"
                                PointerExited="ProductRow_PointerExited"
                            >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Border CornerRadius="12,12,0,0" Background="{StaticResource ShellAvatarSoftBrush}" />
                                        <Border CornerRadius="12,12,0,0">
                                            <Image
                                                Source="{Binding Thumbnail}"
                                                Stretch="UniformToFill"
                                            />
                                        </Border>
                                        <Border
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12,12,0,0"
                                            Background="{Binding StatusBadgeBg}"
                                            BorderBrush="{Binding StatusBadgeFg}"
                                            BorderThickness="1"
                                            CornerRadius="20"
                                            Padding="10,4"
                                        >
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding StatusDotBrush}"
                                                />
                                                <TextBlock
                                                    Text="{Binding StatusLabel}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding StatusBadgeFg}"
                                                    VerticalAlignment="Center"
                                                />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="1"
                                        Padding="16,14,16,16"
                                        Spacing="6"
                                    >
                                        <TextBlock
                                            Text="{Binding CategorySkuLine}"
                                            FontSize="11"
                                            Foreground="#FF9CA3AF"
                                        />
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ShellTextStrongBrush}"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                        />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Text="&#x2605;"
                                                FontSize="14"
                                                Foreground="#FFFBBF24"
                                                VerticalAlignment="Center"
                                            />
                                            <TextBlock
                                                Text="{Binding RatingText}"
                                                FontSize="13"
                                                Foreground="#FF6B7280"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding PriceText}"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                                <TextBlock
                                                    Text="{Binding CompareAtText}"
                                                    FontSize="14"
                                                    Foreground="#FF9CA3AF"
                                                    VerticalAlignment="Center"
                                                    TextDecorations="Strikethrough"
                                                    Visibility="{Binding ShowCompareAt, Converter={StaticResource BoolToVis}}"
                                                />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding StockText}"
                                                FontSize="12"
                                                Foreground="#FF9CA3AF"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                            />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- List view -->
            <ItemsControl
                ItemsSource="{Binding PagedItems}"
                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                Margin="0,0,0,8"
            >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <utu:ShadowContainer Margin="0,0,0,12">
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="2"
                                        BlurRadius="10"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.05"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="{StaticResource ProductCardSurfaceBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                RenderTransformOrigin="0.5,0.5"
                                PointerEntered="ProductRow_PointerEntered"
                                PointerExited="ProductRow_PointerExited"
                            >
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="88"
                                        Height="88"
                                        CornerRadius="10"
                                        Background="{StaticResource ShellAvatarSoftBrush}"
                                    >
                                        <Border CornerRadius="10">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding CategorySkuLine}"
                                                FontSize="11"
                                                Foreground="#FF9CA3AF"
                                                VerticalAlignment="Center"
                                            />
                                            <Border
                                                Background="{Binding StatusBadgeBg}"
                                                BorderBrush="{Binding StatusBadgeFg}"
                                                BorderThickness="1"
                                                CornerRadius="20"
                                                Padding="8,3"
                                            >
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        Fill="{Binding StatusDotBrush}"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding StatusLabel}"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding StatusBadgeFg}"
                                                    />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ShellTextStrongBrush}"
                                        />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="&#x2605;" FontSize="13" Foreground="#FFFBBF24" />
                                            <TextBlock
                                                Text="{Binding RatingText}"
                                                FontSize="13"
                                                Foreground="#FF6B7280"
                                            />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding PriceText}"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                            />
                                            <TextBlock
                                                Text="{Binding CompareAtText}"
                                                FontSize="13"
                                                Foreground="#FF9CA3AF"
                                                TextDecorations="Strikethrough"
                                                Visibility="{Binding ShowCompareAt, Converter={StaticResource BoolToVis}}"
                                            />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding StockText}"
                                        FontSize="13"
                                        Foreground="#FF9CA3AF"
                                        VerticalAlignment="Center"
                                    />
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pagination -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{Binding PageSummaryText}"
                    FontSize="14"
                    Foreground="#FF6B7280"
                    VerticalAlignment="Center"
                />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                >
                    <Button
                        Style="{StaticResource ProductsPaginationChevronStyle}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                    >
                        <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="{StaticResource ShellTextStrongBrush}" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="40"
                                    Height="40"
                                    CornerRadius="8"
                                    Padding="0"
                                    Background="{Binding IsCurrent, Converter={StaticResource PagBg}}"
                                    Foreground="{Binding IsCurrent, Converter={StaticResource PagFg}}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    Command="{Binding DataContext.GoToPageCommand, ElementName=ProductsRootPage}"
                                    CommandParameter="{Binding Page}"
                                    UseSystemFocusVisuals="False"
                                >
                                    <TextBlock
                                        Text="{Binding Page}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Style="{StaticResource ProductsPaginationChevronStyle}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                    >
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource ShellTextStrongBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
