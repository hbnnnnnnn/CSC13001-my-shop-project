<ContentDialog
    x:Class="CSC13001_my_shop_project.Presentation.Products.CreateCategoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:products="using:CSC13001_my_shop_project.Presentation.Products"
    Style="{StaticResource DefaultContentDialogStyle}"
    FullSizeDesired="False"
>
    <ContentDialog.Resources>
        <products:BoolToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#FAF7F2" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#F5EDE4" />
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">420</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">420</x:Double>
    </ContentDialog.Resources>

    <Border Padding="24">
        <StackPanel Spacing="16">
            <TextBlock
                Text="Create Category"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#FF2C2118"
            />

            <StackPanel Spacing="10">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Category name"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FF6B7280"
                    />
                    <TextBox
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. Accessories"
                        Height="40"
                        CornerRadius="8"
                    />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Description (optional)"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FF6B7280"
                    />
                    <TextBox
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Short description"
                        Height="80"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        CornerRadius="8"
                    />
                </StackPanel>
                <TextBlock
                    Text="{Binding ErrorMessage, Mode=OneWay}"
                    FontSize="12"
                    Foreground="#FFDC2626"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button
                    Content="Cancel"
                    Background="#FFF3F4F6"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="16,8"
                    Click="Cancel_Click"
                />
                <Button
                    Content="Create"
                    Background="#F3B55C"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="18,8"
                    Click="Create_Click"
                    IsEnabled="{Binding CanSubmit, Mode=OneWay}"
                />
            </StackPanel>
        </StackPanel>
    </Border>
</ContentDialog>
