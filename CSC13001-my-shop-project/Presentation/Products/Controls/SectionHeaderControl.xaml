<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Products.Controls.SectionHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <StackPanel Margin="0,0,0,0" Spacing="0">
        <TextBlock
            Margin="0,0,0,12"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="#FF2C2118"
            Text="{x:Bind Title, Mode=OneWay}"
        />
        <Border Height="1" Margin="0,0,0,20" Background="#FFF0EDE8" />
    </StackPanel>
</UserControl>
