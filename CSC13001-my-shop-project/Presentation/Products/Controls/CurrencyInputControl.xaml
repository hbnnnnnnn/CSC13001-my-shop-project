<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Products.Controls.CurrencyInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.Products.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d"
>
    <Border
        Background="#FFFAFAF8"
        BorderBrush="#FFE5E1D8"
        BorderThickness="1"
        CornerRadius="8"
    >
        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Padding="8,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding CurrencyOptions, ElementName=Root, Mode=OneWay}"
                SelectedItem="{Binding Currency, ElementName=Root, Mode=TwoWay}"
            />
            <Rectangle
                Grid.Column="1"
                Width="1"
                VerticalAlignment="Stretch"
                Fill="#FFE5E1D8"
            />
            <TextBox
                Grid.Column="2"
                Padding="8,10"
                Background="Transparent"
                BorderThickness="0"
                PlaceholderText="0.00"
                Text="{Binding Amount, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
        </Grid>
    </Border>
</UserControl>
