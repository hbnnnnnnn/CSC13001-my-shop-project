<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Products.Controls.ImageThumbnailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.Products.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <Grid Width="72" Height="72">
        <Border
            Background="#FFF5F3EF"
            BorderBrush="#FFE5E1D8"
            BorderThickness="1"
            CornerRadius="8"
        >
            <Image
                x:Name="ThumbImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="UniformToFill"
            />
        </Border>
        <Border
            x:Name="CoverBadge"
            Margin="4,0,0,4"
            Padding="4,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="#FFF59E0B"
            CornerRadius="4"
            Visibility="Collapsed"
        >
            <TextBlock
                FontSize="10"
                Foreground="White"
                Text="Cover"
            />
        </Border>
    </Grid>
</UserControl>
