<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Products.Controls.ImageThumbnailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CSC13001_my_shop_project.Presentation.Products.Converters"
    x:Name="Root"
    Width="96"
    Height="96"
>
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Border
            Background="#FFFAFAF8"
            BorderBrush="#FFE5E1D8"
            BorderThickness="1"
            CornerRadius="12"
        >
            <Image
                x:Name="PreviewImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="UniformToFill"
            />
        </Border>
        <Border
            Margin="6,6,0,0"
            Padding="6,3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#FF10B981"
            CornerRadius="6"
            Visibility="{x:Bind Item.IsCover, Mode=OneWay, Converter={StaticResource BoolToVis}}"
        >
            <TextBlock
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Cover"
            />
        </Border>
        <Button
            Margin="0,0,4,4"
            Width="28"
            Height="28"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#F5FFFFFF"
            BorderBrush="#FFE5E1D8"
            BorderThickness="1"
            Command="{Binding DataContext.SetCoverCommand, ElementName=DialogRoot}"
            CommandParameter="{x:Bind Item, Mode=OneWay}"
            CornerRadius="14"
            FontSize="12"
            Foreground="#FFF59E0B"
            Visibility="{x:Bind Item.IsCover, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
        >
            <FontIcon FontSize="12" Glyph="&#xE734;" />
        </Button>
    </Grid>
</UserControl>
