<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Products.CreateProductDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSC13001_my_shop_project.Presentation.Products.Controls"
    xmlns:conv="using:CSC13001_my_shop_project.Presentation.Products.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="DialogRoot"
    mc:Ignorable="d"
>
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Border
        Width="880"
        MaxHeight="880"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#FFFFFFFF"
        BorderBrush="#FFF0EDE8"
        BorderThickness="1"
        CornerRadius="16"
    >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid
                Grid.Row="0"
                Padding="24,16"
                BorderBrush="#FFF0EDE8"
                BorderThickness="0,0,0,1"
                Background="#FFFFFFFF"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#FF1A1A1A"
                    Text="CREATE PRODUCT"
                />
                <Button
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Foreground="#FF9CA3AF"
                    FontSize="14"
                />
                <Button
                    Grid.Column="2"
                    Padding="16,10"
                    Background="#FFF59E0B"
                    BorderThickness="0"
                    Command="{Binding SubmitCommand}"
                    Content="Add Product"
                    CornerRadius="10"
                    FontWeight="SemiBold"
                    Foreground="White"
                    IsEnabled="{Binding CanSubmitProduct, Mode=OneWay}"
                />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
            >
                <Grid Padding="24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Spacing="0">
                        <controls:SectionHeaderControl Title="Basic Information" />

                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF9CA3AF"
                                Text="PRODUCT NAME"
                            />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#FFEF4444"
                                Text="*"
                            />
                        </StackPanel>
                        <TextBox
                            Margin="0,0,0,16"
                            Padding="12,10"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="e.g. Nordic Lounge Chair"
                            Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF9CA3AF"
                            Text="DESCRIPTION"
                        />
                        <TextBox
                            Height="110"
                            Margin="0,0,0,4"
                            Padding="12,10"
                            AcceptsReturn="True"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="Write a detailed product description..."
                            Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                        />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="12"
                            Foreground="#FFB0ABA4"
                            Text="Describe the product — materials, dimensions, style."
                        />

                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF9CA3AF">
                                    <Run Text="CATEGORY" />
                                    <Run Foreground="#FFEF4444" Text=" *" />
                                </TextBlock>
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Categories, Mode=OneWay}"
                                    PlaceholderText="Select category"
                                    SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                                    Background="#FFFAFAF8"
                                    BorderBrush="#FFE5E1D8"
                                    CornerRadius="8"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                    Text="SKU"
                                />
                                <TextBox
                                    Padding="12,10"
                                    Background="#FFFAFAF8"
                                    BorderBrush="#FFE5E1D8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    PlaceholderText="e.g. NLC-001"
                                    Text="{Binding Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF9CA3AF"
                            Text="SUPPLIER (OPTIONAL)"
                        />
                        <TextBox
                            Margin="0,0,0,16"
                            Padding="12,10"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="Supplier name"
                            Text="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF9CA3AF"
                            Text="TAGS"
                        />
                        <Grid Margin="0,0,0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TagEntryBox"
                                Grid.Column="0"
                                Padding="12,10"
                                Background="#FFFAFAF8"
                                BorderBrush="#FFE5E1D8"
                                BorderThickness="1"
                                CornerRadius="8"
                                KeyDown="TagEntryBox_KeyDown"
                                PlaceholderText="Add tag..."
                                Text="{Binding TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#FFF59E0B"
                                BorderThickness="0"
                                Command="{Binding AddTagCommand}"
                                Content="+"
                                CornerRadius="18"
                                FontSize="18"
                                Foreground="White"
                            />
                        </Grid>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="#FFB0ABA4"
                            Text="Press Enter or click + to add"
                        />
                        <ItemsControl Margin="0,0,0,24" ItemsSource="{Binding Tags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,6"
                                        Background="#FFF3F4F6"
                                        CornerRadius="20"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            <Button
                                                Padding="4"
                                                MinWidth="24"
                                                MinHeight="24"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.RemoveTagCommand, ElementName=DialogRoot}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                FontSize="14"
                                                Foreground="#FF6B7280"
                                            />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:SectionHeaderControl Title="Pricing" />
                        <Grid Margin="0,0,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF9CA3AF">
                                    <Run Text="PRICE" />
                                    <Run Foreground="#FFEF4444" Text=" *" />
                                </TextBlock>
                                <controls:CurrencyInputControl
                                    Amount="{Binding Price, Mode=TwoWay}"
                                    Currency="{Binding PriceCurrency, Mode=TwoWay}"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                    Text="COMPARE PRICE"
                                />
                                <controls:CurrencyInputControl
                                    Amount="{Binding ComparePrice, Mode=TwoWay}"
                                    Currency="{Binding CompareCurrency, Mode=TwoWay}"
                                />
                                <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="Shown as strikethrough" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                    Text="COST PER ITEM"
                                />
                                <controls:CurrencyInputControl
                                    Amount="{Binding CostPerItem, Mode=TwoWay}"
                                    Currency="{Binding CostCurrency, Mode=TwoWay}"
                                />
                                <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="Not shown to customers" />
                            </StackPanel>
                        </Grid>

                        <controls:SectionHeaderControl Title="Inventory &amp; Shipping" />
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Spacing="12">
                            <ToggleSwitch IsOn="{Binding TrackQuantity, Mode=TwoWay}" OffContent="" OnContent="" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#FF1A1A1A"
                                Text="Track quantity"
                            />
                        </StackPanel>

                        <Grid
                            Margin="0,0,0,16"
                            ColumnSpacing="12"
                            Visibility="{Binding TrackQuantity, Converter={StaticResource BoolToVis}}"
                        >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                    Text="QUANTITY"
                                />
                                <TextBox
                                    Padding="12,10"
                                    Background="#FFFAFAF8"
                                    BorderBrush="#FFE5E1D8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    InputScope="Number"
                                    PlaceholderText="0"
                                    Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                    Text="WEIGHT"
                                />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Background="#FFFAFAF8"
                                        BorderBrush="#FFE5E1D8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        PlaceholderText="0.00"
                                        Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    />
                                    <ComboBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding WeightUnits, Mode=OneWay}"
                                        SelectedItem="{Binding WeightUnit, Mode=TwoWay}"
                                    />
                                </Grid>
                                <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="For shipping rates" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF9CA3AF"
                            Text="DIMENSIONS"
                        />
                        <TextBox
                            Width="260"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,10"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="e.g. 80 × 60 × 45"
                            Text="{Binding Dimensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                        <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="L × W × H in cm" />

                        <TextBlock
                            Margin="0,16,0,0"
                            Foreground="#FFEF4444"
                            Text="{Binding ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}"
                        />
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="1" Spacing="0">
                        <Border
                            Padding="16"
                            Background="#FFFFFFFF"
                            BorderBrush="#FFF0EDE8"
                            BorderThickness="1"
                            CornerRadius="14"
                        >
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1A1A1A"
                                    Text="Media"
                                />
                                <Border
                                    Height="140"
                                    HorizontalAlignment="Stretch"
                                    Background="#FFFAF8F5"
                                    BorderBrush="#FFD4CFCA"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Tapped="UploadZone_Tapped"
                                >
                                    <StackPanel
                                        Padding="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                    >
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="32"
                                            Foreground="#FFF59E0B"
                                            Glyph="&#xE898;"
                                        />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="Upload images"
                                        />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FF9CA3AF"
                                            Text="Click or drag &amp; drop"
                                        />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#FFC4BFB8"
                                            Text="PNG, JPG, WEBP up to 10MB"
                                        />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ItemsControl ItemsSource="{Binding UploadedImages, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <controls:ImageThumbnailControl Item="{Binding}" />
                                                        <Button
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,2,2,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#99000000"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveImageCommand, ElementName=DialogRoot}"
                                                            CommandParameter="{Binding}"
                                                            Content="×"
                                                            Foreground="White"
                                                            FontSize="12"
                                                        />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,12,0,0"
                            Padding="16"
                            Background="#FFFEF9EE"
                            CornerRadius="14"
                        >
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1A1A1A"
                                    Text="Summary"
                                />
                                <controls:SummaryRowControl
                                    Label="Name"
                                    ShowBottomDivider="True"
                                    Value="{Binding SummaryNameDisplay, Mode=OneWay}"
                                />
                                <controls:SummaryRowControl
                                    Label="Category"
                                    ShowBottomDivider="True"
                                    Value="{Binding SummaryCategoryDisplay, Mode=OneWay}"
                                />
                                <controls:SummaryRowControl
                                    Label="Price"
                                    ShowBottomDivider="True"
                                    Value="{Binding FormattedPrice, Mode=OneWay}"
                                />
                                <controls:SummaryRowControl
                                    Label="Stock"
                                    ShowBottomDivider="False"
                                    Value="{Binding SummaryStockDisplay, Mode=OneWay}"
                                />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="#80FFFFFF"
                IsHitTestVisible="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
            >
                <ProgressRing
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{Binding IsBusy, Mode=OneWay}"
                />
            </Grid>
        </Grid>
    </Border>
</UserControl>
