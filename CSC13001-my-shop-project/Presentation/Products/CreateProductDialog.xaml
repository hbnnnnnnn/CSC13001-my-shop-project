<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Products.CreateProductDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSC13001_my_shop_project.Presentation.Products.Controls"
    xmlns:conv="using:CSC13001_my_shop_project.Presentation.Products.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="DialogRoot"
    RequestedTheme="Light"
    mc:Ignorable="d"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Material ComboBox reads placeholder/chevron via ThemeResource; set brushes in theme dicts. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPressed" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundDisabled" Color="#996B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxArrowForeground" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxArrowForegroundOpened" Color="#FF6B7280" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPressed" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundDisabled" Color="#996B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxArrowForeground" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="ComboBoxArrowForegroundOpened" Color="#FF6B7280" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />

            <!-- Keep typed text dark on hover/focus (theme defaults can flip to light foreground). -->
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF000000" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF000000" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#66000000" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlCaretBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFAFAF8" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFAFAF8" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FF000000" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FF000000" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FF000000" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#66000000" />

            <Style x:Key="CreateFormTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="#FF000000" />
                <Setter Property="PlaceholderForeground" Value="#FF9CA3AF" />
            </Style>
            <Style x:Key="CreateFormComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#FF000000" />
                <Setter Property="PlaceholderForeground" Value="#FF6B7280" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Width="880"
        MaxHeight="880"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#FFFFFFFF"
        BorderBrush="#FFF0EDE8"
        BorderThickness="1"
        CornerRadius="16"
    >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid
                Grid.Row="0"
                Padding="24,16"
                BorderBrush="#FFF0EDE8"
                BorderThickness="0,0,0,1"
                Background="#FFFFFFFF"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#FF1A1A1A"
                    Text="{Binding DialogTitle, Mode=OneWay}"
                />
                <Button
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Foreground="#FF6B7280"
                    FontSize="14"
                />
                <Button
                    Grid.Column="2"
                    Padding="16,10"
                    Background="#FFF59E0B"
                    BorderThickness="0"
                    Command="{Binding SubmitCommand}"
                    Content="{Binding SubmitLabel, Mode=OneWay}"
                    CornerRadius="10"
                    FontWeight="SemiBold"
                    Foreground="White"
                    IsEnabled="{Binding CanSubmitProduct, Mode=OneWay}"
                />
            </Grid>

            <Border
                Grid.Row="1"
                Padding="24,10"
                Background="#FFFFF7ED"
                BorderBrush="#66F59E0B"
                BorderThickness="0,0,0,1"
                Visibility="{Binding TopBannerMessage, Converter={StaticResource StringNotEmptyToVis}}"
            >
                <TextBlock
                    FontSize="14"
                    Foreground="#FFB45309"
                    Text="{Binding TopBannerMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                />
            </Border>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
            >
                <Grid Padding="24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Spacing="0">
                        <StackPanel Spacing="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1A1A1A"
                                    Text="Basic Information"
                                />
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding RequestAiSuggestionCommand}"
                                    ToolTipService.ToolTip="Suggest name and description from the cover image"
                                    AutomationProperties.Name="Sparkle: suggest from cover image"
                                >
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <Storyboard>
                                                                <ColorAnimation
                                                                    EnableDependentAnimation="True"
                                                                    Storyboard.TargetName="SparkleFillBrush"
                                                                    Storyboard.TargetProperty="Color"
                                                                    To="#FFF59E0B"
                                                                    Duration="0:0:0.12"
                                                                />
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="IconRoot"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.08"
                                                                />
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <ColorAnimation
                                                                    EnableDependentAnimation="True"
                                                                    Storyboard.TargetName="SparkleFillBrush"
                                                                    Storyboard.TargetProperty="Color"
                                                                    To="#FFE08A12"
                                                                    Duration="0:0:0.12"
                                                                />
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <ColorAnimation
                                                                    EnableDependentAnimation="True"
                                                                    Storyboard.TargetName="SparkleFillBrush"
                                                                    Storyboard.TargetProperty="Color"
                                                                    To="#FFC76A00"
                                                                    Duration="0:0:0.06"
                                                                />
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="IconRoot"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0.35"
                                                                    Duration="0:0:0"
                                                                />
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Viewbox
                                                    x:Name="IconRoot"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                >
                                                    <Path Data="M 12,4 L 16.5,12 L 12,20 L 7.5,12 Z M 5,2.5 L 7.5,6 L 5,9.5 L 2.5,6 Z M 19,1.5 L 21.5,4.5 L 19,7.5 L 16.5,4.5 Z">
                                                        <Path.Fill>
                                                            <SolidColorBrush x:Name="SparkleFillBrush" Color="#FFF59E0B" />
                                                        </Path.Fill>
                                                    </Path>
                                                </Viewbox>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Rectangle
                                Height="1"
                                Margin="0,8,0,16"
                                HorizontalAlignment="Stretch"
                                Fill="#FFF0EDE8"
                            />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF6B7280"
                                Text="PRODUCT NAME"
                            />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#FFEF4444"
                                Text="*"
                            />
                        </StackPanel>
                        <TextBox
                            Style="{StaticResource CreateFormTextBoxStyle}"
                            Margin="0,0,0,16"
                            Padding="12,10"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="e.g. Nordic Lounge Chair"
                            Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF6B7280"
                            Text="DESCRIPTION"
                        />
                        <TextBox
                            Style="{StaticResource CreateFormTextBoxStyle}"
                            Height="110"
                            Margin="0,0,0,4"
                            Padding="12,10"
                            AcceptsReturn="True"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="Write a detailed product description..."
                            Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                        />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="12"
                            Foreground="#FFB0ABA4"
                            Text="Describe the product — materials, dimensions, style."
                        />

                        <Grid Margin="0,0,0,16" ColumnSpacing="12" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Bottom"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF6B7280"
                            >
                                <Run Text="CATEGORY" />
                                <Run Foreground="#FFEF4444" Text=" *" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF6B7280"
                                Text="SKU"
                            />
                            <Border
                                x:Name="CategoryPickerHost"
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Background="#FFFAFAF8"
                                BorderBrush="#FFE5E1D8"
                                BorderThickness="1"
                                CornerRadius="8"
                                PointerPressed="CategoryPickerHost_PointerPressed"
                                Tapped="CategoryPickerHost_Tapped"
                            >
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <Border
                                            MinWidth="200"
                                            Width="{Binding ActualWidth, ElementName=CategoryPickerHost}"
                                            Padding="4"
                                            Background="#FFFFFFFF"
                                            BorderBrush="#FFE5E1D8"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                        >
                                            <ScrollViewer MaxHeight="280">
                                                <ItemsControl ItemsSource="{Binding Categories, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="CategoryPickItem_Click"
                                                                Padding="12,10"
                                                            >
                                                                <TextBlock Foreground="#FF1A1A1A" Text="{Binding Name}" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Style="{StaticResource CreateFormTextBoxStyle}"
                                        Padding="12,10,4,10"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        IsHitTestVisible="False"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        PlaceholderText="Select category"
                                        Text="{Binding CategorySelectionDisplay, Mode=OneWay}"
                                    />
                                    <Path
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Data="M0 0L5 5L10 0H0Z"
                                        Fill="#FF6B7280"
                                        IsHitTestVisible="False"
                                        Stretch="Uniform"
                                        Width="10"
                                        Height="5"
                                    />
                                </Grid>
                            </Border>
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{StaticResource CreateFormTextBoxStyle}"
                                Padding="12,10"
                                Background="#FFFAFAF8"
                                BorderBrush="#FFE5E1D8"
                                BorderThickness="1"
                                CornerRadius="8"
                                PlaceholderText="e.g. NLC-001"
                                Text="{Binding Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            />
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF6B7280"
                            Text="SUPPLIER (OPTIONAL)"
                        />
                        <TextBox
                            Style="{StaticResource CreateFormTextBoxStyle}"
                            Margin="0,0,0,16"
                            Padding="12,10"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="Supplier name"
                            Text="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF6B7280"
                            Text="TAGS"
                        />
                        <Grid Margin="0,0,0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TagEntryBox"
                                Style="{StaticResource CreateFormTextBoxStyle}"
                                Grid.Column="0"
                                Padding="12,10"
                                Background="#FFFAFAF8"
                                BorderBrush="#FFE5E1D8"
                                BorderThickness="1"
                                CornerRadius="8"
                                KeyDown="TagEntryBox_KeyDown"
                                PlaceholderText="Add tag..."
                                Text="{Binding TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#FFF59E0B"
                                BorderThickness="0"
                                Command="{Binding AddTagCommand}"
                                Content="+"
                                CornerRadius="18"
                                FontSize="18"
                                Foreground="White"
                            />
                        </Grid>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="#FFB0ABA4"
                            Text="Press Enter or click + to add"
                        />
                        <ItemsControl Margin="0,0,0,24" ItemsSource="{Binding Tags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,6"
                                        Background="#FFF3F4F6"
                                        CornerRadius="20"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="#FF000000"
                                                Text="{Binding}"
                                            />
                                            <Button
                                                Padding="4"
                                                MinWidth="24"
                                                MinHeight="24"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.RemoveTagCommand, ElementName=DialogRoot}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                FontSize="14"
                                                Foreground="#FF6B7280"
                                            />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:SectionHeaderControl Title="Pricing" />
                        <Grid Margin="0,0,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF6B7280">
                                    <Run Text="PRICE" />
                                    <Run Foreground="#FFEF4444" Text=" *" />
                                </TextBlock>
                                <controls:CurrencyInputControl
                                    Amount="{Binding Price, Mode=TwoWay}"
                                    Currency="{Binding PriceCurrency, Mode=TwoWay}"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF6B7280"
                                    Text="COMPARE PRICE"
                                />
                                <controls:CurrencyInputControl
                                    Amount="{Binding ComparePrice, Mode=TwoWay}"
                                    Currency="{Binding CompareCurrency, Mode=TwoWay}"
                                />
                                <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="Shown as strikethrough" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF6B7280"
                                    Text="COST PER ITEM"
                                />
                                <controls:CurrencyInputControl
                                    Amount="{Binding CostPerItem, Mode=TwoWay}"
                                    Currency="{Binding CostCurrency, Mode=TwoWay}"
                                />
                                <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="Not shown to customers" />
                            </StackPanel>
                        </Grid>

                        <controls:SectionHeaderControl Title="Inventory &amp; Shipping" />
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Spacing="12">
                            <ToggleSwitch IsOn="{Binding TrackQuantity, Mode=TwoWay}" OffContent="" OnContent="" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#FF1A1A1A"
                                Text="Track quantity"
                            />
                        </StackPanel>

                        <Grid
                            Margin="0,0,0,16"
                            ColumnSpacing="12"
                            Visibility="{Binding TrackQuantity, Converter={StaticResource BoolToVis}}"
                        >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF6B7280"
                                    Text="QUANTITY"
                                />
                                <TextBox
                                    Style="{StaticResource CreateFormTextBoxStyle}"
                                    Padding="12,10"
                                    Background="#FFFAFAF8"
                                    BorderBrush="#FFE5E1D8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    InputScope="Number"
                                    PlaceholderText="0"
                                    Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF6B7280"
                                    Text="WEIGHT"
                                />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Style="{StaticResource CreateFormTextBoxStyle}"
                                        Padding="12,10"
                                        Background="#FFFAFAF8"
                                        BorderBrush="#FFE5E1D8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        PlaceholderText="0.00"
                                        Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    />
                                    <ComboBox
                                        Grid.Column="1"
                                        Style="{StaticResource CreateFormComboBoxStyle}"
                                        VerticalAlignment="Center"
                                        Background="#FFFAFAF8"
                                        BorderBrush="#FFE5E1D8"
                                        CornerRadius="8"
                                        ItemsSource="{Binding WeightUnits, Mode=OneWay}"
                                        SelectedItem="{Binding WeightUnit, Mode=TwoWay}"
                                    />
                                </Grid>
                                <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="For shipping rates" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF6B7280"
                            Text="DIMENSIONS"
                        />
                        <TextBox
                            Style="{StaticResource CreateFormTextBoxStyle}"
                            Width="260"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,10"
                            Background="#FFFAFAF8"
                            BorderBrush="#FFE5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            PlaceholderText="e.g. 80 × 60 × 45"
                            Text="{Binding Dimensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                        <TextBlock FontSize="12" Foreground="#FFB0ABA4" Text="L × W × H in cm" />

                        <TextBlock
                            Margin="0,16,0,0"
                            Foreground="#FFEF4444"
                            Text="{Binding ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}"
                        />
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="1" Spacing="0">
                        <Border
                            Padding="16"
                            Background="#FFFFFFFF"
                            BorderBrush="#FFF0EDE8"
                            BorderThickness="1"
                            CornerRadius="14"
                        >
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1A1A1A"
                                    Text="Media"
                                />
                                <Border
                                    Height="140"
                                    HorizontalAlignment="Stretch"
                                    Background="#FFFAF8F5"
                                    BorderBrush="#FFD4CFCA"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Tapped="UploadZone_Tapped"
                                >
                                    <StackPanel
                                        Padding="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                    >
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="32"
                                            Foreground="#FFF59E0B"
                                            Glyph="&#xE898;"
                                        />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="Upload images"
                                        />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FF6B7280"
                                            Text="Click or drag &amp; drop"
                                        />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#FFC4BFB8"
                                            Text="PNG, JPG, WEBP up to 10MB"
                                        />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ItemsControl ItemsSource="{Binding UploadedImages, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <controls:ImageThumbnailControl Item="{Binding}" />
                                                        <Button
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,2,2,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#99000000"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveImageCommand, ElementName=DialogRoot}"
                                                            CommandParameter="{Binding}"
                                                            Content="×"
                                                            Foreground="White"
                                                            FontSize="12"
                                                        />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,12,0,0"
                            Padding="16"
                            Background="#FFFEF9EE"
                            CornerRadius="14"
                        >
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1A1A1A"
                                    Text="Summary"
                                />
                                <controls:SummaryRowControl
                                    Label="Name"
                                    ShowBottomDivider="True"
                                    Value="{Binding SummaryNameDisplay, Mode=OneWay}"
                                />
                                <controls:SummaryRowControl
                                    Label="Category"
                                    ShowBottomDivider="True"
                                    Value="{Binding SummaryCategoryDisplay, Mode=OneWay}"
                                />
                                <controls:SummaryRowControl
                                    Label="Price"
                                    ShowBottomDivider="True"
                                    Value="{Binding FormattedPrice, Mode=OneWay}"
                                />
                                <controls:SummaryRowControl
                                    Label="Stock"
                                    ShowBottomDivider="False"
                                    Value="{Binding SummaryStockDisplay, Mode=OneWay}"
                                />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="#80FFFFFF"
                IsHitTestVisible="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
            >
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                >
                    <ProgressRing
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        IsActive="{Binding IsBusy, Mode=OneWay}"
                    />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#FF1A1A1A"
                        Text="Generating...."
                        Visibility="{Binding IsAiGenerating, Converter={StaticResource BoolToVis}}"
                    />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
