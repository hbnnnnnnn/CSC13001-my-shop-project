<ContentDialog
    x:Class="CSC13001_my_shop_project.Presentation.Products.DeleteProductDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    FullSizeDesired="False"
>
    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#FAF7F2" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#F5EDE4" />
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">382</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">382</x:Double>
    </ContentDialog.Resources>

    <Border Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
            <Border
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="0.8"
                CornerRadius="24"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
            >
                <FontIcon
                    Glyph="&#xE74D;"
                    FontSize="22"
                    Foreground="#EF4444"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                />
            </Border>

            <TextBlock
                Text="Delete Product"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#FF2C2118"
                HorizontalAlignment="Center"
            />

            <TextBlock
                x:Name="ConfirmMessage"
                FontSize="14"
                Foreground="#992C2118"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                MaxWidth="296"
            />

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button
                    x:Name="CancelBtn"
                    Click="CancelBtn_Click"
                    Height="38"
                    Background="#FFF3F4F6"
                    BorderThickness="0"
                    CornerRadius="10"
                    Padding="16,0"
                >
                    <TextBlock
                        Text="Cancel"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FF374151"
                    />
                </Button>
                <Button
                    x:Name="DeleteBtn"
                    Click="DeleteBtn_Click"
                    Height="38"
                    Background="#EF4444"
                    BorderThickness="0"
                    CornerRadius="10"
                    Padding="16,0"
                >
                    <TextBlock
                        Text="Delete"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                    />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</ContentDialog>
