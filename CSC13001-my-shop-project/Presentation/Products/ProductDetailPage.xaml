<Page
    x:Class="CSC13001_my_shop_project.Presentation.Products.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CSC13001_my_shop_project.Presentation.Products.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.Products"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="#F5F3EF"
    mc:Ignorable="d"
>
    <Page.Resources>
        <conv:StatusColorConverter x:Key="StatusColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />

        <SolidColorBrush x:Key="DetailPrimaryTextBrush" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="DetailMutedTextBrush" Color="#FF9CA3AF" />
        <SolidColorBrush x:Key="DetailDividerBrush" Color="#FFF0EDE8" />
        <SolidColorBrush x:Key="DetailLinkBrush" Color="#FFF3B55C" />
        <SolidColorBrush x:Key="DetailTagBgBrush" Color="#FFF5F3EF" />

        <Style x:Key="DetailOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#FFE5E2DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style
            x:Key="DetailDeleteOutlineButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DetailOutlineButtonStyle}"
        >
            <Setter Property="Foreground" Value="#FFEF4444" />
            <Setter Property="BorderBrush" Value="#FFEF4444" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        x:Name="DetailPageRoot"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
    >
        <Grid Padding="32,24,32,32" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <!-- Back arrow -->
                    <Button
                        Padding="4,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                    >
                        <FontIcon
                            Glyph="&#xE72B;"
                            FontSize="14"
                            Foreground="{StaticResource DetailMutedTextBrush}"
                        />
                    </Button>
                    <!-- Data-driven breadcrumb segments -->
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <!-- Clickable segment -->
                                    <Button
                                        Padding="6,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BreadcrumbBack_Click"
                                        Visibility="{Binding IsClickable, Converter={StaticResource BoolToVisConverter}}"
                                    >
                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#FF9CA3AF"
                                            Text="{Binding Label}"
                                        />
                                    </Button>
                                    <!-- Separator + current (non-clickable) segment -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{Binding IsClickable, Converter={StaticResource InverseBoolToVisConverter}}"
                                    >
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="#FF9CA3AF"
                                            Margin="6,0"
                                            Text="/"
                                        />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#FF1A1A1A"
                                            Text="{Binding Label}"
                                        />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                >
                    <Button
                        Command="{Binding EditProductCommand}"
                        Style="{StaticResource DetailOutlineButtonStyle}"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="16" />
                            <TextBlock Text="Edit Product" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding DeleteProductCommand}"
                        Style="{StaticResource DetailDeleteOutlineButtonStyle}"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="Delete" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Two columns -->
            <Grid Grid.Row="1" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <utu:ShadowContainer>
                        <utu:ShadowContainer.Shadows>
                            <utu:ShadowCollection>
                                <utu:Shadow
                                    OffsetX="0"
                                    OffsetY="2"
                                    BlurRadius="12"
                                    Spread="0"
                                    Color="#000000"
                                    Opacity="0.08"
                                />
                            </utu:ShadowCollection>
                        </utu:ShadowContainer.Shadows>
                        <Border
                            Background="White"
                            CornerRadius="16"
                            BorderBrush="{StaticResource DetailDividerBrush}"
                            BorderThickness="1"
                        >
                            <Grid>
                                <Border CornerRadius="16" Height="360" Background="#FFF5F3EF">
                                    <Image
                                        Source="{Binding Product.Thumbnail, Mode=OneWay}"
                                        Stretch="UniformToFill"
                                    />
                                </Border>
                                <Border
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="16,16,0,0"
                                    Background="{Binding Product.StatusBadgeBackground, Mode=OneWay}"
                                    BorderBrush="{Binding Product.StatusBadgeForeground, Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="10,6"
                                >
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Product.StatusDotBrush, Mode=OneWay}"
                                        />
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Product.StatusBadgeForeground, Mode=OneWay}"
                                            Text="{Binding Product.StatusLabel, Mode=OneWay}"
                                        />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </utu:ShadowContainer>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <utu:ShadowContainer Grid.Column="0">
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="2"
                                        BlurRadius="8"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.06"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="{StaticResource DetailDividerBrush}"
                                BorderThickness="1"
                                Padding="16"
                            >
                                <Grid>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding Product.TotalSold, Mode=OneWay}"
                                    >
                                        <FontIcon
                                            Glyph="&#xE8C8;"
                                            FontSize="12"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                        />
                                    </Button>
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <FontIcon
                                            Glyph="&#xE719;"
                                            FontSize="22"
                                            Foreground="#FFF3B55C"
                                        />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                            Text="Total Sold"
                                        />
                                        <TextBlock
                                            FontSize="24"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding Product.TotalSold, Mode=OneWay}"
                                        />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                        <utu:ShadowContainer Grid.Column="1">
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="2"
                                        BlurRadius="8"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.06"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="{StaticResource DetailDividerBrush}"
                                BorderThickness="1"
                                Padding="16"
                            >
                                <Grid>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding Product.RevenueText, Mode=OneWay}"
                                    >
                                        <FontIcon
                                            Glyph="&#xE8C8;"
                                            FontSize="12"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                        />
                                    </Button>
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <FontIcon
                                            Glyph="&#xE9A6;"
                                            FontSize="22"
                                            Foreground="#FF22C55E"
                                        />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                            Text="Revenue"
                                        />
                                        <TextBlock
                                            FontSize="24"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding Product.RevenueText, Mode=OneWay}"
                                        />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                        <utu:ShadowContainer Grid.Column="2">
                            <utu:ShadowContainer.Shadows>
                                <utu:ShadowCollection>
                                    <utu:Shadow
                                        OffsetX="0"
                                        OffsetY="2"
                                        BlurRadius="8"
                                        Spread="0"
                                        Color="#000000"
                                        Opacity="0.06"
                                    />
                                </utu:ShadowCollection>
                            </utu:ShadowContainer.Shadows>
                            <Border
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="{StaticResource DetailDividerBrush}"
                                BorderThickness="1"
                                Padding="16"
                            >
                                <Grid>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding Product.StockLevelText, Mode=OneWay}"
                                    >
                                        <FontIcon
                                            Glyph="&#xE8C8;"
                                            FontSize="12"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                        />
                                    </Button>
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <FontIcon
                                            Glyph="&#xE73E;"
                                            FontSize="22"
                                            Foreground="#FF14B8A6"
                                        />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                            Text="Stock Left"
                                        />
                                        <TextBlock
                                            FontSize="24"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding Product.StockLeft, Mode=OneWay}"
                                        />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </utu:ShadowContainer>
                    </Grid>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <utu:ShadowContainer>
                        <utu:ShadowContainer.Shadows>
                            <utu:ShadowCollection>
                                <utu:Shadow
                                    OffsetX="0"
                                    OffsetY="2"
                                    BlurRadius="12"
                                    Spread="0"
                                    Color="#000000"
                                    Opacity="0.08"
                                />
                            </utu:ShadowCollection>
                        </utu:ShadowContainer.Shadows>
                        <Border
                            Background="White"
                            CornerRadius="16"
                            BorderBrush="{StaticResource DetailDividerBrush}"
                            BorderThickness="1"
                            Padding="24"
                        >
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DetailMutedTextBrush}"
                                    Text="{Binding Product.Category, Mode=OneWay}"
                                />
                                <TextBlock
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DetailPrimaryTextBrush}"
                                    Text="{Binding Product.Name, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <local:StarRatingControl Rating="{Binding Product.Rating, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource DetailMutedTextBrush}"
                                        Text="{Binding Product.RatingReviewsText, Mode=OneWay}"
                                    />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DetailPrimaryTextBrush}"
                                    Text="{Binding Product.PriceText, Mode=OneWay}"
                                />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{StaticResource DetailMutedTextBrush}"
                                    Text="{Binding Product.CostMarginLine, Mode=OneWay}"
                                />
                                <Border
                                    Height="1"
                                    Background="{StaticResource DetailDividerBrush}"
                                    Margin="0,4,0,4"
                                />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DetailMutedTextBrush}"
                                    Text="DESCRIPTION"
                                />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource DetailPrimaryTextBrush}"
                                    Text="{Binding Product.Description, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                />
                                <ItemsControl ItemsSource="{Binding Product.Tags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{StaticResource DetailTagBgBrush}"
                                                CornerRadius="20"
                                                Padding="10,6"
                                                BorderBrush="{StaticResource DetailDividerBrush}"
                                                BorderThickness="1"
                                            >
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        Fill="{StaticResource DetailMutedTextBrush}"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                                        Text="{Binding}"
                                                    />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </utu:ShadowContainer>

                    <utu:ShadowContainer>
                        <utu:ShadowContainer.Shadows>
                            <utu:ShadowCollection>
                                <utu:Shadow
                                    OffsetX="0"
                                    OffsetY="2"
                                    BlurRadius="12"
                                    Spread="0"
                                    Color="#000000"
                                    Opacity="0.08"
                                />
                            </utu:ShadowCollection>
                        </utu:ShadowContainer.Shadows>
                        <Border
                            Background="White"
                            CornerRadius="16"
                            BorderBrush="{StaticResource DetailDividerBrush}"
                            BorderThickness="1"
                            Padding="24"
                        >
                            <StackPanel Spacing="0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DetailPrimaryTextBrush}"
                                    Text="Product Details"
                                    Margin="0,0,0,16"
                                />
                                <Grid
                                    Padding="0,12"
                                    BorderBrush="{StaticResource DetailDividerBrush}"
                                    BorderThickness="0,0,0,1"
                                >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource DetailMutedTextBrush}"
                                        Text="SKU"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="{Binding Product.Sku, Mode=OneWay}"
                                    />
                                    <Button
                                        Grid.Column="2"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding Product.Sku, Mode=OneWay}"
                                    >
                                        <FontIcon
                                            Glyph="&#xE8C8;"
                                            FontSize="14"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                        />
                                    </Button>
                                </Grid>
                                <Grid
                                    Padding="0,12"
                                    BorderBrush="{StaticResource DetailDividerBrush}"
                                    BorderThickness="0,0,0,1"
                                >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource DetailMutedTextBrush}"
                                        Text="Barcode"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="{Binding Product.Barcode, Mode=OneWay}"
                                    />
                                    <Button
                                        Grid.Column="2"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CopyTextCommand}"
                                        CommandParameter="{Binding Product.Barcode, Mode=OneWay}"
                                    >
                                        <FontIcon
                                            Glyph="&#xE8C8;"
                                            FontSize="14"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                        />
                                    </Button>
                                </Grid>
                                <Grid
                                    Padding="0,12"
                                    BorderBrush="{StaticResource DetailDividerBrush}"
                                    BorderThickness="0,0,0,1"
                                >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource DetailMutedTextBrush}"
                                        Text="Weight"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="{Binding Product.Weight, Mode=OneWay}"
                                    />
                                </Grid>
                                <Grid
                                    Padding="0,12"
                                    BorderBrush="{StaticResource DetailDividerBrush}"
                                    BorderThickness="0,0,0,1"
                                >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource DetailMutedTextBrush}"
                                        Text="Dimensions"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="{Binding Product.Dimensions, Mode=OneWay}"
                                    />
                                </Grid>
                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource DetailMutedTextBrush}"
                                        Text="Date Added"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="{Binding Product.DateAdded, Mode=OneWay}"
                                    />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </utu:ShadowContainer>

                    <utu:ShadowContainer>
                        <utu:ShadowContainer.Shadows>
                            <utu:ShadowCollection>
                                <utu:Shadow
                                    OffsetX="0"
                                    OffsetY="2"
                                    BlurRadius="12"
                                    Spread="0"
                                    Color="#000000"
                                    Opacity="0.08"
                                />
                            </utu:ShadowCollection>
                        </utu:ShadowContainer.Shadows>
                        <Border
                            Background="White"
                            CornerRadius="16"
                            BorderBrush="{StaticResource DetailDividerBrush}"
                            BorderThickness="1"
                            Padding="24"
                        >
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="Inventory"
                                        VerticalAlignment="Center"
                                    />
                                    <Border
                                        HorizontalAlignment="Right"
                                        Background="{Binding Product.StatusBadgeBackground, Mode=OneWay}"
                                        BorderBrush="{Binding Product.StatusBadgeForeground, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="10,6"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                Fill="{Binding Product.StatusDotBrush, Mode=OneWay}"
                                            />
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding Product.StatusBadgeForeground, Mode=OneWay}"
                                                Text="{Binding Product.StatusLabel, Mode=OneWay}"
                                            />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource DetailMutedTextBrush}"
                                    Text="Stock level"
                                />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="{Binding Product.StockTotal, Mode=OneWay}"
                                        Value="{Binding Product.StockLeft, Mode=OneWay}"
                                        Height="10"
                                        CornerRadius="5"
                                        Foreground="#FF22C55E"
                                        Background="#FFE5E7EB"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DetailPrimaryTextBrush}"
                                        Text="{Binding Product.StockLevelText, Mode=OneWay}"
                                    />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </utu:ShadowContainer>
                </StackPanel>
            </Grid>

            <!-- Recent orders -->
            <utu:ShadowContainer Grid.Row="2" Margin="0,24,0,0">
                <utu:ShadowContainer.Shadows>
                    <utu:ShadowCollection>
                        <utu:Shadow
                            OffsetX="0"
                            OffsetY="2"
                            BlurRadius="12"
                            Spread="0"
                            Color="#000000"
                            Opacity="0.08"
                        />
                    </utu:ShadowCollection>
                </utu:ShadowContainer.Shadows>
                <Border
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="{StaticResource DetailDividerBrush}"
                    BorderThickness="1"
                    Padding="24"
                >
                    <StackPanel Spacing="16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE9D2;" FontSize="20" Foreground="#FFF3B55C" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DetailPrimaryTextBrush}"
                                    Text="Recent Orders for this Product"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="0"
                                Command="{Binding ViewAllOrdersCommand}"
                                Foreground="{StaticResource DetailLinkBrush}"
                            >
                                <TextBlock FontWeight="SemiBold" Text="View All Orders →" />
                            </HyperlinkButton>
                        </Grid>

                        <Grid ColumnSpacing="8" Padding="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DetailMutedTextBrush}"
                                Text="ORDER ID"
                            />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DetailMutedTextBrush}"
                                Text="CUSTOMER"
                            />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DetailMutedTextBrush}"
                                Text="DATE"
                            />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DetailMutedTextBrush}"
                                Text="QTY"
                            />
                            <TextBlock
                                Grid.Column="4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DetailMutedTextBrush}"
                                Text="TOTAL"
                            />
                            <TextBlock
                                Grid.Column="5"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DetailMutedTextBrush}"
                                Text="STATUS"
                            />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentOrders, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,12"
                                        Background="{Binding RowBackground}"
                                        ColumnSpacing="8"
                                    >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding OrderId}"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding Customer}"
                                        />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource DetailMutedTextBrush}"
                                            Text="{Binding Date}"
                                        />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding Quantity}"
                                        />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DetailPrimaryTextBrush}"
                                            Text="{Binding Total}"
                                        />
                                        <Border
                                            Grid.Column="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="10,4"
                                            CornerRadius="20"
                                            Background="{Binding Status, Converter={StaticResource StatusColorConverter}, ConverterParameter=Background}"
                                        >
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}, ConverterParameter=Foreground}"
                                                Text="{Binding Status}"
                                            />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </utu:ShadowContainer>
        </Grid>
    </ScrollViewer>
</Page>
