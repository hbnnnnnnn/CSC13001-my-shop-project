<ContentDialog
    x:Class="CSC13001_my_shop_project.Presentation.Products.DeleteProductSuccessDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    FullSizeDesired="False"
>
    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#FAF7F2" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#F5EDE4" />
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">382</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">382</x:Double>
    </ContentDialog.Resources>

    <Border Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
            <Border
                Background="#F0FDF4"
                BorderBrush="#BBF7D0"
                BorderThickness="0.8"
                CornerRadius="24"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
            >
                <FontIcon
                    Glyph="&#xE73E;"
                    FontSize="24"
                    Foreground="#22C55E"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                />
            </Border>

            <TextBlock
                Text="Product Deleted"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#FF2C2118"
                HorizontalAlignment="Center"
            />

            <TextBlock
                x:Name="SuccessMessage"
                FontSize="14"
                Foreground="#992C2118"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                MaxWidth="296"
            />

            <Button
                x:Name="OkBtn"
                Click="OkBtn_Click"
                HorizontalAlignment="Stretch"
                Height="38"
                Background="#F3B55C"
                BorderThickness="0"
                CornerRadius="10"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="0,8,0,0"
            >
                <TextBlock
                    Text="OK"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                />
            </Button>
        </StackPanel>
    </Border>
</ContentDialog>
