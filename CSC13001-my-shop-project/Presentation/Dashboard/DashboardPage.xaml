<Page
    x:Class="CSC13001_my_shop_project.Presentation.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CSC13001_my_shop_project.Presentation.Dashboard"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{StaticResource ShellBackgroundBrush}"
>
    <Page.Resources>
        <!-- Chart area gradient fill -->
        <LinearGradientBrush x:Key="ChartAreaFillBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#44F3B55C" Offset="0" />
            <GradientStop Color="#04F3B55C" Offset="1" />
        </LinearGradientBrush>

        <!-- ── "View All" text-link button: underline rectangle on hover ── -->
        <Style x:Key="ViewAllLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                        >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="UnderlineBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.12"
                                            />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="UnderlineBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12"
                                            />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="UnderlineBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0"
                                            />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="LabelText"
                                        Text="{TemplateBinding Tag}"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource ShellAccentBrush}"
                                    />
                                    <Rectangle
                                        x:Name="UnderlineBar"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Fill="{StaticResource ShellAccentBrush}"
                                        Opacity="0"
                                    />
                                </Grid>
                                <Canvas Width="10" Height="10" VerticalAlignment="Center">
                                    <Path
                                        Data="M2 1.5L8.5 5L2 8.5"
                                        Stroke="{StaticResource ShellAccentBrush}"
                                        StrokeThickness="1.5"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                    />
                                </Canvas>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="0">
            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  PAGE HEADER                                           -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPanel Spacing="4" Margin="0,0,0,20">
                <TextBlock
                    Text="DASHBOARD"
                    FontSize="28"
                    FontWeight="ExtraBold"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                    CharacterSpacing="50"
                />
                <TextBlock
                    Text="Welcome back, Admin. Here's what's happening today"
                    FontSize="15"
                    Foreground="#FF6B7280"
                />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  STAT CARDS ROW                                        -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid ColumnSpacing="24" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card: Total Products -->
                <utu:ShadowContainer Grid.Column="0">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="ProductsCardBorder"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="110"
                        PointerEntered="ProductsCard_PointerEntered"
                        PointerExited="ProductsCard_PointerExited"
                    >
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="ProductsCardTransform" />
                        </Border.RenderTransform>
                        <Grid Padding="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="Total Products"
                                    FontSize="13"
                                    Foreground="#FF9CA3AF"
                                />
                                <TextBlock
                                    Text="{Binding TotalProducts}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <!-- Package / box icon -->
                            <Border
                                Grid.Column="1"
                                Width="52"
                                Height="52"
                                CornerRadius="10"
                                Background="#FFF5EDE4"
                                VerticalAlignment="Center"
                            >
                                <Viewbox Width="26" Height="26">
                                    <Canvas Width="22" Height="22">
                                        <Path
                                            Data="M19.25 7.33333C19.2497 7.01183 19.1648 6.69608 19.0039 6.41773C18.843 6.13939 18.6118 5.90825 18.3333 5.7475L11.9167 2.08083C11.638 1.91992 11.3218 1.83521 11 1.83521C10.6782 1.83521 10.362 1.91992 10.0833 2.08083L3.66667 5.7475C3.38824 5.90825 3.15698 6.13939 2.99609 6.41773C2.8352 6.69608 2.75033 7.01183 2.75 7.33333V14.6667C2.75033 14.9882 2.8352 15.3039 2.99609 15.5823C3.15698 15.8606 3.38824 16.0918 3.66667 16.2525L10.0833 19.9192C10.362 20.0801 10.6782 20.1648 11 20.1648C11.3218 20.1648 11.638 20.0801 11.9167 19.9192L18.3333 16.2525C18.6118 16.0918 18.843 15.8606 19.0039 15.5823C19.1648 15.3039 19.2497 14.9882 19.25 14.6667V7.33333"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="1.83"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                        />
                                        <Path
                                            Data="M3.025 6.41667L11 11L18.975 6.41667"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="1.83"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                        />
                                        <Path
                                            Data="M11 20.1667V11"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="1.83"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                        />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <!-- Card: Total Orders -->
                <utu:ShadowContainer Grid.Column="1">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="OrdersCardBorder"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="110"
                        PointerEntered="OrdersCard_PointerEntered"
                        PointerExited="OrdersCard_PointerExited"
                    >
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="OrdersCardTransform" />
                        </Border.RenderTransform>
                        <Grid Padding="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="Total Orders"
                                    FontSize="13"
                                    Foreground="#FF9CA3AF"
                                />
                                <TextBlock
                                    Text="{Binding TotalOrders}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <!-- Shopping cart icon (orange tint, same as Products) -->
                            <Border
                                Grid.Column="1"
                                Width="52"
                                Height="52"
                                CornerRadius="10"
                                Background="#FFF5EDE4"
                                VerticalAlignment="Center"
                            >
                                <Viewbox Width="26" Height="26">
                                    <Canvas Width="22" Height="22">
                                        <Path
                                            Data="M7.33333 20.1667C7.83959 20.1667 8.25 19.7563 8.25 19.25C8.25 18.7437 7.83959 18.3333 7.33333 18.3333C6.82707 18.3333 6.41667 18.7437 6.41667 19.25C6.41667 19.7563 6.82707 20.1667 7.33333 20.1667Z"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="1.83"
                                            Fill="{StaticResource ShellAccentBrush}"
                                        />
                                        <Path
                                            Data="M17.4167 20.1667C17.9229 20.1667 18.3333 19.7563 18.3333 19.25C18.3333 18.7437 17.9229 18.3333 17.4167 18.3333C16.9104 18.3333 16.5 18.7437 16.5 19.25C16.5 19.7563 16.9104 20.1667 17.4167 20.1667Z"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="1.83"
                                            Fill="{StaticResource ShellAccentBrush}"
                                        />
                                        <Path
                                            Data="M1.87917 1.87917H3.7125L6.15083 13.2642C6.24028 13.6811 6.47228 14.0539 6.8069 14.3182C7.14152 14.5826 7.55783 14.722 7.98417 14.7125H16.9492C17.3664 14.7118 17.7709 14.5688 18.0959 14.3072C18.4209 14.0455 18.647 13.6808 18.7367 13.2733L20.2492 6.4625H4.69333"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="1.83"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                        />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>

                <!-- Card: Total Revenue -->
                <utu:ShadowContainer Grid.Column="2">
                    <utu:ShadowContainer.Shadows>
                        <utu:ShadowCollection>
                            <utu:Shadow
                                OffsetX="0"
                                OffsetY="4"
                                BlurRadius="14"
                                Spread="0"
                                Color="#000000"
                                Opacity="0.07"
                            />
                        </utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <Border
                        x:Name="RevenueCardBorder"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="110"
                        PointerEntered="RevenueCard_PointerEntered"
                        PointerExited="RevenueCard_PointerExited"
                    >
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="RevenueCardTransform" />
                        </Border.RenderTransform>
                        <Grid Padding="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="Total Revenue"
                                    FontSize="13"
                                    Foreground="#FF9CA3AF"
                                />
                                <TextBlock
                                    Text="{Binding TotalRevenue}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                />
                            </StackPanel>
                            <!-- Revenue / dollar icon (orange tint, same as Products) -->
                            <Border
                                Grid.Column="1"
                                Width="52"
                                Height="52"
                                CornerRadius="10"
                                Background="#FFF5EDE4"
                                VerticalAlignment="Center"
                            >
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path
                                            Data="M12 1v22"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="2"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                        />
                                        <Path
                                            Data="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                                            Stroke="{StaticResource ShellAccentBrush}"
                                            StrokeThickness="2"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                        />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </utu:ShadowContainer>
            </Grid>
            <!-- end STAT CARDS -->

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  MAIN CONTENT: LEFT PANEL + RIGHT PANEL               -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <!-- Daily Sales Chart Card -->
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                    >
                        <StackPanel>
                            <!-- Chart header -->
                            <Grid Padding="24,20,24,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="Daily Sales Overview"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource ShellTextStrongBrush}"
                                    />
                                    <TextBlock
                                        Text="Sales revenue by day — March 2026"
                                        FontSize="13"
                                        Foreground="#FF9CA3AF"
                                    />
                                </StackPanel>
                                <!-- Period label -->
                                <Border
                                    Grid.Column="1"
                                    Background="{StaticResource ShellAccentBrush}"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                >
                                    <TextBlock
                                        Text="Daily"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                    />
                                </Border>
                            </Grid>

                            <!--
                                Area Chart  (Canvas 880x270 inside Viewbox)
                                Plot area  : x=52..876, y=12..220  (824x208 px)
                                Y-mapping  : $0=220  $2k=168  $4k=116  $6k=64  $8k=12
                                X-mapping  : day D -> x = (D-1)*27.6 + 52  (~27.6px/day)
                                X-labels   : Mar 1, Mar 5, Mar 9, Mar 13, Mar 17, Mar 21, Mar 25, Mar 29
                            -->
                            <Viewbox
                                Stretch="Fill"
                                Height="270"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                            >
                                <Canvas
                                    x:Name="ChartCanvas"
                                    Width="880"
                                    Height="270"
                                    Background="Transparent"
                                    PointerMoved="Chart_PointerMoved"
                                    PointerExited="Chart_PointerExited"
                                >
                                    <!-- Horizontal grid lines -->
                                    <Line
                                        X1="52"
                                        Y1="12"
                                        X2="876"
                                        Y2="12"
                                        Stroke="#10000000"
                                        StrokeThickness="1"
                                    />
                                    <Line
                                        X1="52"
                                        Y1="64"
                                        X2="876"
                                        Y2="64"
                                        Stroke="#10000000"
                                        StrokeThickness="1"
                                    />
                                    <Line
                                        X1="52"
                                        Y1="116"
                                        X2="876"
                                        Y2="116"
                                        Stroke="#10000000"
                                        StrokeThickness="1"
                                    />
                                    <Line
                                        X1="52"
                                        Y1="168"
                                        X2="876"
                                        Y2="168"
                                        Stroke="#10000000"
                                        StrokeThickness="1"
                                    />
                                    <Line
                                        X1="52"
                                        Y1="220"
                                        X2="876"
                                        Y2="220"
                                        Stroke="#22000000"
                                        StrokeThickness="1"
                                    />

                                    <!-- Y-axis labels -->
                                    <TextBlock
                                        Canvas.Left="4"
                                        Canvas.Top="4"
                                        Text="$8k"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="4"
                                        Canvas.Top="56"
                                        Text="$6k"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="4"
                                        Canvas.Top="108"
                                        Text="$4k"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="4"
                                        Canvas.Top="160"
                                        Text="$2k"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="4"
                                        Canvas.Top="212"
                                        Text="$0"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />

                                    <!-- Area fill (closes at baseline y=220) -->
                                    <Polygon
                                        Points="52,158 79,130 106,108 133,80 160,46 187,64 214,96 241,116 268,136 295,86 322,56 349,86 376,124 403,104 430,124 457,148 484,112 511,78 538,96 565,68 592,44 619,72 646,108 673,88 700,116 727,104 754,128 781,148 808,136 835,158 862,140 876,152 876,220 52,220"
                                        Fill="{StaticResource ChartAreaFillBrush}"
                                    />

                                    <!-- Chart line -->
                                    <Polyline
                                        Points="52,158 79,130 106,108 133,80 160,46 187,64 214,96 241,116 268,136 295,86 322,56 349,86 376,124 403,104 430,124 457,148 484,112 511,78 538,96 565,68 592,44 619,72 646,108 673,88 700,116 727,104 754,128 781,148 808,136 835,158 862,140"
                                        Stroke="{StaticResource ShellAccentBrush}"
                                        StrokeThickness="2.5"
                                        StrokeLineJoin="Round"
                                    />

                                    <!-- ── Interactive hover elements (controlled from code-behind) ── -->
                                    <Ellipse
                                        x:Name="ChartHoverDotOuter"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="14"
                                        Height="14"
                                        Fill="White"
                                        Visibility="Collapsed"
                                    />
                                    <Ellipse
                                        x:Name="ChartHoverDotInner"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="8"
                                        Height="8"
                                        Fill="{StaticResource ShellAccentBrush}"
                                        Visibility="Collapsed"
                                    />
                                    <Border
                                        x:Name="ChartTooltip"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        Background="#E21F2937"
                                        CornerRadius="5"
                                        Padding="8,5"
                                        Visibility="Collapsed"
                                    >
                                        <TextBlock
                                            x:Name="ChartTooltipText"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            TextAlignment="Center"
                                        />
                                    </Border>

                                    <!-- X-axis labels (every 4 days) -->
                                    <TextBlock
                                        Canvas.Left="38"
                                        Canvas.Top="228"
                                        Text="Mar 1"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="148"
                                        Canvas.Top="228"
                                        Text="Mar 5"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="258"
                                        Canvas.Top="228"
                                        Text="Mar 9"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="365"
                                        Canvas.Top="228"
                                        Text="Mar 13"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="475"
                                        Canvas.Top="228"
                                        Text="Mar 17"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="582"
                                        Canvas.Top="228"
                                        Text="Mar 21"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="692"
                                        Canvas.Top="228"
                                        Text="Mar 25"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                    <TextBlock
                                        Canvas.Left="800"
                                        Canvas.Top="228"
                                        Text="Mar 29"
                                        FontSize="11"
                                        Foreground="#FF9CA3AF"
                                    />
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <!-- end Daily Sales Chart -->

                    <!-- Recent Orders Card -->
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                    >
                        <StackPanel>
                            <!-- Section header -->
                            <Grid Margin="0,0,0,16">
                                <TextBlock
                                    Text="Recent Orders"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                    VerticalAlignment="Center"
                                />
                                <!-- View All Orders button (navigates to Order List) -->
                                <Button
                                    x:Name="ViewAllOrdersButton"
                                    Style="{StaticResource ViewAllLinkStyle}"
                                    Tag="View All Orders"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ViewAllOrders_Click"
                                />
                            </Grid>

                            <!-- Column headers -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="ORDER ID"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="CUSTOMER"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="STATUS"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="TOTAL"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9CA3AF"
                                />
                            </Grid>

                            <Border
                                Height="1"
                                Background="{StaticResource ShellBorderBrush}"
                                Margin="0,0,0,4"
                            />

                            <!-- Order rows -->
                            <ItemsControl ItemsSource="{Binding RecentOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            BorderBrush="{StaticResource ShellBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="8"
                                            Padding="8,12"
                                            PointerEntered="RowBorder_PointerEntered"
                                            PointerExited="RowBorder_PointerExited"
                                        >
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding OrderId}"
                                                    FontSize="13"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding Customer}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                                <!-- Status badge: simple pill -->
                                                <Border
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding StatusBgBrush}"
                                                    BorderBrush="{Binding StatusBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9,4"
                                                >
                                                    <TextBlock
                                                        Text="{Binding Status}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding StatusFgBrush}"
                                                        VerticalAlignment="Center"
                                                    />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding Total}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    VerticalAlignment="Center"
                                                />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- end Recent Orders -->

                    <!-- Low Stock Alert Card -->
                    <Border
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                    >
                        <StackPanel>
                            <!-- Section header with alert badge -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                >
                                    <TextBlock
                                        Text="Low Stock Alert"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource ShellTextStrongBrush}"
                                        VerticalAlignment="Center"
                                    />
                                    <!-- Alert badge (red pill, text only) -->
                                    <Border
                                        Background="#FFFEF2F2"
                                        BorderBrush="#FFFECACA"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,4"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock
                                            Text="{Binding LowStockBadgeText}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#FFEF4444"
                                            VerticalAlignment="Center"
                                        />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Low stock item rows -->
                            <ItemsControl ItemsSource="{Binding LowStockItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            BorderBrush="{StaticResource ShellBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="8"
                                            Padding="8,14"
                                            PointerEntered="RowBorder_PointerEntered"
                                            PointerExited="RowBorder_PointerExited"
                                        >
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail: placeholder + real image overlay -->
                                                <Grid
                                                    Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    Margin="0,0,14,0"
                                                >
                                                    <Border
                                                        CornerRadius="8"
                                                        Background="{StaticResource ShellAvatarSoftBrush}"
                                                    />
                                                    <Border CornerRadius="8">
                                                        <Image
                                                            Source="{Binding Thumbnail}"
                                                            Stretch="UniformToFill"
                                                        />
                                                    </Border>
                                                </Grid>

                                                <!-- Product info + stock badge -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4"
                                                >
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource ShellTextStrongBrush}"
                                                    />
                                                    <!-- Stock badge (text only) -->
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        Background="#FFFEF2F2"
                                                        BorderBrush="#FFFECACA"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="7,3"
                                                    >
                                                        <TextBlock
                                                            Text="{Binding StockMessage}"
                                                            FontSize="11"
                                                            FontWeight="Medium"
                                                            Foreground="#FFEF4444"
                                                        />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- end Low Stock Alert -->
                </StackPanel>
                <!-- end LEFT PANEL -->

                <!-- RIGHT PANEL: Best Selling -->
                <Border
                    Grid.Column="1"
                    Background="#FFFFFFFF"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    VerticalAlignment="Top"
                >
                    <StackPanel>
                        <!-- Section header -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock
                                Text="Best Selling"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                                VerticalAlignment="Center"
                            />
                            <!-- View All → navigate to All Products -->
                            <Button
                                x:Name="ViewAllProductsButton"
                                Style="{StaticResource ViewAllLinkStyle}"
                                Tag="View All"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ViewAllProducts_Click"
                            />
                        </Grid>

                        <!-- Best selling item rows -->
                        <ItemsControl ItemsSource="{Binding BestSellingItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="8"
                                        Padding="8,10"
                                        PointerEntered="RowBorder_PointerEntered"
                                        PointerExited="RowBorder_PointerExited"
                                    >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Thumbnail: placeholder + real image overlay -->
                                            <Grid
                                                Grid.Column="0"
                                                Width="42"
                                                Height="42"
                                                Margin="0,0,10,0"
                                            >
                                                <Border
                                                    CornerRadius="8"
                                                    Background="{StaticResource ShellAvatarSoftBrush}"
                                                />
                                                <Border CornerRadius="8">
                                                    <Image
                                                        Source="{Binding Thumbnail}"
                                                        Stretch="UniformToFill"
                                                    />
                                                </Border>
                                            </Grid>
                                            <!-- Name + sold count -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2"
                                            >
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource ShellTextStrongBrush}"
                                                    TextWrapping="Wrap"
                                                />
                                                <TextBlock
                                                    Text="{Binding SoldText}"
                                                    FontSize="12"
                                                    Foreground="#FF9CA3AF"
                                                />
                                            </StackPanel>
                                            <!-- Price -->
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding Price}"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                                VerticalAlignment="Center"
                                            />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- end RIGHT PANEL -->
            </Grid>
            <!-- end MAIN CONTENT GRID -->

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  FOOTER                                                -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border
                Margin="0,24,0,0"
                Padding="0,16"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="0,1,0,0"
            >
                <Grid>
                    <TextBlock
                        Text="&#169; 2026 Lumina Haven Admin"
                        FontSize="13"
                        Foreground="#FF9CA3AF"
                        VerticalAlignment="Center"
                    />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="20">
                        <TextBlock
                            Text="Support"
                            FontSize="13"
                            Foreground="#FF9CA3AF"
                            VerticalAlignment="Center"
                        />
                        <TextBlock
                            Text="Privacy"
                            FontSize="13"
                            Foreground="#FF9CA3AF"
                            VerticalAlignment="Center"
                        />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
