<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Layout.TopBarControl"
    x:Name="TopBarRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="80"
    d:DesignWidth="1280"
>
    <UserControl.Resources>
        <Style x:Key="ShellIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ShellSearchBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="46,13,16,13" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource ShellTextStrongBrush}" />
            <Setter
                Property="PlaceholderForeground"
                Value="{StaticResource ShellSearchTextBrush}"
            />
            <Setter Property="SelectionHighlightColor" Value="{StaticResource ShellAccentBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        Height="80"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellHeaderDividerBrush}"
        BorderThickness="0,0,0,1"
        Padding="24,0,32,0"
    >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="672" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Open Sidebar Button -->
            <Button
                x:Name="OpenSidebarButton"
                Style="{StaticResource ShellIconButtonStyle}"
                Grid.Column="0"
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Command="{Binding ElementName=TopBarRoot, Path=OpenSidebarCommand}"
            >
                <Grid Width="20" Height="20">
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,3.5,2.5,0"
                    />
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,0,2.5,0"
                    />
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,0,2.5,3.5"
                    />
                </Grid>
            </Button>

            <!-- Search Input -->
            <Grid Grid.Column="2" Height="44" VerticalAlignment="Center">
                <TextBox
                    x:Name="SearchInput"
                    Style="{StaticResource ShellSearchTextBoxStyle}"
                    PlaceholderText="Search products..."
                    PlaceholderForeground="{StaticResource ShellSearchTextBrush}"
                    GotFocus="OnSearchFocused"
                    LostFocus="OnSearchUnfocused"
                >
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#80F5EDE4" />
                        <SolidColorBrush
                            x:Key="TextControlBackgroundPointerOver"
                            Color="#80F5EDE4"
                        />
                        <SolidColorBrush
                            x:Key="TextControlSelectionHighlightColor"
                            Color="#CC2C2118"
                        />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF2C2118" />
                        <SolidColorBrush x:Key="TextControlCaretBrush" Color="#FF2C2118" />
                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <!-- focus ring overlay -->
                <Border
                    x:Name="SearchFocusRing"
                    CornerRadius="22"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    IsHitTestVisible="False"
                />

                <!-- search icon -->
                <Viewbox
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="16,0,0,0"
                    IsHitTestVisible="False"
                >
                    <Canvas Width="18" Height="18">
                        <Path
                            Data="M8.25 14.25C11.5637 14.25 14.25 11.5637 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25Z"
                            Stroke="{StaticResource ShellSearchIconBrush}"
                            StrokeThickness="1.5"
                        />
                        <Path
                            Data="M15.75 15.7504L12.525 12.5254"
                            Stroke="{StaticResource ShellSearchIconBrush}"
                            StrokeThickness="1.5"
                        />
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Right Side: Notification + Admin -->
            <Grid Grid.Column="4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="36" Height="36" VerticalAlignment="Center">
                    <Viewbox
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                    >
                        <Canvas Width="20" Height="20">
                            <Path
                                Data="M8.55667 17.5C8.70295 17.7533 8.91335 17.9637 9.1667 18.11C9.42006 18.2563 9.70745 18.3333 10 18.3333C10.2925 18.3333 10.5799 18.2563 10.8333 18.11C11.0867 17.9637 11.297 17.7533 11.4433 17.5"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                                StrokeThickness="1.67"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                            />
                            <Path
                                Data="M2.71833 12.7717C2.60947 12.891 2.53763 13.0394 2.51155 13.1988C2.48546 13.3582 2.50627 13.5217 2.57142 13.6695C2.63658 13.8173 2.74328 13.943 2.87855 14.0312C3.01381 14.1195 3.17182 14.1665 3.33333 14.1667H16.6667C16.8282 14.1667 16.9862 14.1199 17.1216 14.0318C17.2569 13.9437 17.3637 13.8181 17.4291 13.6704C17.4944 13.5227 17.5154 13.3592 17.4895 13.1998C17.4637 13.0404 17.392 12.892 17.2833 12.7725C16.175 11.63 15 10.4158 15 6.66667C15 5.34058 14.4732 4.06881 13.5355 3.13113C12.5979 2.19345 11.3261 1.66667 10 1.66667C8.67392 1.66667 7.40215 2.19345 6.46447 3.13113C5.52678 4.06881 5 5.34058 5 6.66667C5 10.4158 3.82417 11.63 2.71833 12.7717Z"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                                StrokeThickness="1.67"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                            />
                        </Canvas>
                    </Viewbox>
                    <Border
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        Background="{StaticResource ShellNotificationDotBrush}"
                        BorderBrush="{StaticResource ShellBackgroundBrush}"
                        BorderThickness="1.6"
                        CornerRadius="999"
                    />
                </Grid>

                <Border
                    Grid.Column="2"
                    Width="1"
                    Height="32"
                    VerticalAlignment="Center"
                    Background="{StaticResource ShellBorderBrush}"
                />

                <StackPanel
                    Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10"
                >
                    <Border
                        Width="32"
                        Height="32"
                        CornerRadius="999"
                        Background="{StaticResource ShellAvatarGradientBrush}"
                    >
                        <TextBlock
                            Text="AD"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="Bold"
                        />
                    </Border>
                    <TextBlock
                        Text="Admin"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                    />
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Path
                            Data="M3.5 5.25L7 8.75L10.5 5.25"
                            Stroke="{StaticResource ShellTextMutedBrush}"
                            StrokeThickness="1.17"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                        />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
