<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Layout.TopBarControl"
    x:Name="TopBarRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="80"
    d:DesignWidth="1280"
>
    <UserControl.Resources>
        <Style x:Key="ShellIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellBorderBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellBorderBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellBorderBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border
        Height="80"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellHeaderDividerBrush}"
        BorderThickness="0,0,0,1"
        Padding="24,0,32,0"
    >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Open Sidebar Button -->
            <Button
                x:Name="OpenSidebarButton"
                Style="{StaticResource ShellIconButtonStyle}"
                Grid.Column="0"
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Command="{Binding ElementName=TopBarRoot, Path=OpenSidebarCommand}"
            >
                <Grid Width="20" Height="20">
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,3.5,2.5,0"
                    />
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,0,2.5,0"
                    />
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,0,2.5,3.5"
                    />
                </Grid>
            </Button>

            <!-- Search Input -->
            <Grid Grid.Column="1" Width="672" Height="44" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBox
                    x:Name="SearchInput"
                    Style="{StaticResource ShellSearchTextBoxStyle}"
                    PlaceholderText="Search products..."
                    PlaceholderForeground="{StaticResource ShellSearchTextBrush}"
                    GotFocus="OnSearchFocused"
                    LostFocus="OnSearchUnfocused"
                >
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#80F5EDE4" />
                        <SolidColorBrush
                            x:Key="TextControlBackgroundPointerOver"
                            Color="#80F5EDE4"
                        />
                        <SolidColorBrush
                            x:Key="TextControlSelectionHighlightColor"
                            Color="#CC2C2118"
                        />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF2C2118" />
                        <SolidColorBrush x:Key="TextControlCaretBrush" Color="#FF2C2118" />
                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <!-- focus ring overlay -->
                <Border
                    x:Name="SearchFocusRing"
                    CornerRadius="22"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    IsHitTestVisible="False"
                />

                <!-- search icon -->
                <Viewbox
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="16,0,0,0"
                    IsHitTestVisible="False"
                >
                    <Canvas Width="18" Height="18">
                        <Path
                            Data="M8.25 14.25C11.5637 14.25 14.25 11.5637 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25Z"
                            Stroke="{StaticResource ShellSearchIconBrush}"
                            StrokeThickness="1.5"
                        />
                        <Path
                            Data="M15.75 15.7504L12.525 12.5254"
                            Stroke="{StaticResource ShellSearchIconBrush}"
                            StrokeThickness="1.5"
                        />
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Right Side: Admin -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Button Style="{StaticResource AdminButtonStyle}" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="MinWidth" Value="220" />
                                    <Setter Property="MaxWidth" Value="220" />
                                    <Setter Property="Transitions">
                                        <Setter.Value>
                                            <TransitionCollection>
                                                <PopupThemeTransition />
                                            </TransitionCollection>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <StackPanel>
                                <!-- Profile Header -->
                                <StackPanel Orientation="Horizontal" Padding="10,10,10,12" Spacing="10">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        CornerRadius="999"
                                        Background="{StaticResource ShellAvatarGradientBrush}"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock
                                            Text="AD"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            FontSize="13"
                                            FontWeight="Bold"
                                        />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="Admin"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ShellTextStrongBrush}"
                                        />
                                        <TextBlock
                                            Text="admin@luminahaven.com"
                                            FontSize="11"
                                            Foreground="{StaticResource ShellTextSubtleBrush}"
                                        />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource ShellBorderBrush}" Margin="4,0,4,4" />

                                <!-- Sign Out -->
                                <Button Style="{StaticResource FlyoutMenuItemStyle}" HorizontalAlignment="Stretch">
                                    <Grid Padding="10,9" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Canvas Width="20" Height="20">
                                            <Path
                                                Data="M8.33 15.83H4.17C3.71 15.83 3.33 15.46 3.33 15V5C3.33 4.54 3.71 4.17 4.17 4.17H8.33"
                                                Stroke="#D95959"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                            />
                                            <Path
                                                Data="M13.33 13.33L16.67 10L13.33 6.67"
                                                Stroke="#D95959"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                            />
                                            <Path
                                                Data="M16.67 10H7.5"
                                                Stroke="#D95959"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                            />
                                        </Canvas>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Sign out"
                                            FontSize="13"
                                            Foreground="#D95959"
                                            VerticalAlignment="Center"
                                        />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="12,6"
                    >
                        <Border
                            Width="32"
                            Height="32"
                            CornerRadius="999"
                            Background="{StaticResource ShellAvatarGradientBrush}"
                        >
                            <TextBlock
                                Text="AD"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                FontSize="12"
                                FontWeight="Bold"
                            />
                        </Border>
                        <TextBlock
                            Text="Admin"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource ShellTextStrongBrush}"
                        />
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Path
                                Data="M3.5 5.25L7 8.75L10.5 5.25"
                                Stroke="{StaticResource ShellTextMutedBrush}"
                                StrokeThickness="1.17"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            />
                        </Grid>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
