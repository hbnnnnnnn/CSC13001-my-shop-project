<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Layout.TopBarControl"
    x:Name="TopBarRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="using:CSC13001_my_shop_project.Presentation.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utu="using:Uno.Toolkit.UI"
    mc:Ignorable="d"
    d:DesignHeight="80"
    d:DesignWidth="1280"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TopBarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Height="80"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellHeaderDividerBrush}"
        BorderThickness="0,0,0,1"
        Padding="24,0,32,0"
    >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Open Sidebar Button -->
            <Button
                x:Name="OpenSidebarButton"
                Style="{StaticResource ShellIconButtonStyle}"
                Grid.Column="0"
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Command="{Binding ElementName=TopBarRoot, Path=OpenSidebarCommand}"
            >
                <Grid Width="20" Height="20">
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,3.5,2.5,0"
                    />
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,0,2.5,0"
                    />
                    <Path
                        Data="M0.833333 0.833333H14.1667"
                        Stroke="{StaticResource ShellIconMutedBrush}"
                        StrokeThickness="1.67"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="2.5,0,2.5,3.5"
                    />
                </Grid>
            </Button>

            <!-- Search bar removed -->

            <!-- Right Side: Admin + Notification -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10"
                FlowDirection="RightToLeft"
            >
                <Button
                    x:Name="ProfileButton"
                    Style="{StaticResource AdminButtonStyle}"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                >
                    <Button.Flyout>
                        <Flyout
                            Placement="BottomEdgeAlignedRight"
                            x:Name="ProfileFlyout"
                            Opened="ProfileFlyout_Opened"
                            Closed="ProfileFlyout_Closed"
                        >
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter
                                        Property="Background"
                                        Value="{StaticResource ShellBackgroundBrush}"
                                    />
                                    <Setter
                                        Property="BorderBrush"
                                        Value="{StaticResource ShellBorderBrush}"
                                    />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="16" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="220" />
                                    <Setter Property="MaxWidth" Value="220" />
                                    <Setter Property="Translation" Value="0,0,16" />
                                    <Setter Property="Shadow">
                                        <Setter.Value>
                                            <ThemeShadow />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Transitions">
                                        <Setter.Value>
                                            <TransitionCollection>
                                                <PopupThemeTransition />
                                            </TransitionCollection>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <Flyout.Content>
                                <StackPanel>
                                    <!-- Profile Header -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Padding="12,12,12,14"
                                        Spacing="10"
                                        Background="#fdf8f0"
                                    >
                                        <layout:AvatarBadgeControl
                                            AvatarSize="40"
                                            InitialsFontSize="13"
                                            DisplayName="{Binding UserName}"
                                            VerticalAlignment="Center"
                                        />
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{Binding UserName}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource ShellTextStrongBrush}"
                                            />
                                            <TextBlock
                                                Text="{Binding UserEmail}"
                                                FontSize="11"
                                                Foreground="{StaticResource ShellTextSubtleBrush}"
                                            />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Background="White">
                                        <!-- Divider -->
                                        <Border
                                            Height="1"
                                            Background="{StaticResource ShellBorderBrush}"
                                            Margin="0"
                                        />

                                        <Button Style="{StaticResource MyProfileMenuItemStyle}" />
                                        <Button Style="{StaticResource PreferencesMenuItemStyle}" />

                                        <Border
                                            Height="1"
                                            Background="{StaticResource ShellBorderBrush}"
                                            Margin="0"
                                        />

                                        <!-- Sign Out -->
                                        <Button
                                            Style="{StaticResource SignOutMenuItemStyle}"
                                            Click="SignOutButton_Click"
                                        />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout.Content>
                        </Flyout>
                    </Button.Flyout>

                    <Button.Content>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="12,6"
                        >
                            <layout:AvatarBadgeControl
                                AvatarSize="32"
                                InitialsFontSize="11"
                                DisplayName="{Binding UserName}"
                            />
                            <TextBlock
                                Text="{Binding UserName}"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource ShellTextStrongBrush}"
                            />
                            <Grid
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                            >
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="ProfileChevronRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <Path
                                    Data="M3.5 5.25L7 8.75L10.5 5.25"
                                    Stroke="{StaticResource ShellTextMutedBrush}"
                                    StrokeThickness="1.17"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                />
                            </Grid>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- separator -->
                <Border
                    Width="1"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{StaticResource ShellHeaderDividerBrush}"
                />

                <!-- notification bell -->
                <Button
                    Style="{StaticResource ShellIconButtonStyle}"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    ToolTipService.ToolTip="Notifications"
                >
                    <Grid Width="20" Height="20">
                        <Path
                            Data="M10 2.92C7.24 2.92 5 5.16 5 7.92V10.84C5 11.46 4.76 12.05 4.32 12.49L3.4 13.41C3.05 13.76 2.95 14.29 3.13 14.74C3.31 15.2 3.75 15.5 4.25 15.5H15.75C16.25 15.5 16.69 15.2 16.87 14.74C17.05 14.29 16.95 13.76 16.6 13.41L15.68 12.49C15.24 12.05 15 11.46 15 10.84V7.92C15 5.16 12.76 2.92 10 2.92Z"
                            Stroke="{StaticResource ShellIconMutedBrush}"
                            StrokeThickness="1.4"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent"
                        />
                        <Path
                            Data="M8.1 15.5C8.33 16.36 9.11 17 10 17C10.89 17 11.67 16.36 11.9 15.5"
                            Stroke="{StaticResource ShellIconMutedBrush}"
                            StrokeThickness="1.4"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                        />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
