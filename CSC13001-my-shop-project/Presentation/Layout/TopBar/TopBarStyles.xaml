<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <SolidColorBrush x:Key="ProfileButtonOpenBackgroundBrush" Color="#f5ede4" />

    <Style x:Key="ShellIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Root"
                                        Storyboard.TargetProperty="Background"
                                    >
                                        <DiscreteObjectKeyFrame
                                            KeyTime="0"
                                            Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                        />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Root"
                                        Storyboard.TargetProperty="Background"
                                    >
                                        <DiscreteObjectKeyFrame
                                            KeyTime="0"
                                            Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                        />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AdminButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" CornerRadius="10">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f5ede4" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f5ede4" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>

                            <VisualStateGroup>
                                <VisualState x:Name="FlyoutClosed" />
                                <VisualState x:Name="FlyoutOpen">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="FlyoutLayer"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f5ede4" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="FlyoutLayer" Background="Transparent" CornerRadius="10" />
                        <Border x:Name="HoverLayer" Background="Transparent" CornerRadius="10" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PreferencesMenuItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#fdf8f0" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="TextItem"
                                            Storyboard.TargetProperty="Foreground"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#2C2118" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Icon1"
                                            Storyboard.TargetProperty="Stroke"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f3b55c" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Icon2"
                                            Storyboard.TargetProperty="Stroke"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f3b55c" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Icon3"
                                            Storyboard.TargetProperty="Stroke"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f3b55c" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Icon4"
                                            Storyboard.TargetProperty="Stroke"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#f3b55c" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#fdf8f0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Padding="12,11" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="20" Height="20">
                                <Path
                                    x:Name="Icon1"
                                    Data="M8.33 3.33H11.67"
                                    Stroke="{StaticResource ShellIconMutedBrush}"
                                    StrokeThickness="1.4"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                />
                                <Path
                                    x:Name="Icon2"
                                    Data="M10 6.67V13.33"
                                    Stroke="{StaticResource ShellIconMutedBrush}"
                                    StrokeThickness="1.4"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                />
                                <Path
                                    x:Name="Icon3"
                                    Data="M6.67 10H13.33"
                                    Stroke="{StaticResource ShellIconMutedBrush}"
                                    StrokeThickness="1.4"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                />
                                <Path
                                    x:Name="Icon4"
                                    Data="M10 16.67C13.68 16.67 16.67 13.68 16.67 10C16.67 6.32 13.68 3.33 10 3.33C6.32 3.33 3.33 6.32 3.33 10C3.33 13.68 6.32 16.67 10 16.67Z"
                                    Stroke="{StaticResource ShellIconMutedBrush}"
                                    StrokeThickness="1.4"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                />
                            </Canvas>
                            <TextBlock
                                x:Name="TextItem"
                                Grid.Column="1"
                                Text="Preferences"
                                FontSize="13"
                                Foreground="{StaticResource ShellIconMutedBrush}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

