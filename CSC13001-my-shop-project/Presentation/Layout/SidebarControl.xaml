<UserControl
    x:Class="CSC13001_my_shop_project.Presentation.Layout.SidebarControl"
    x:Name="SidebarRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="using:CSC13001_my_shop_project.Presentation.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="260"
>
    <UserControl.Resources>
        <Style x:Key="ShellIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background"
                                        >
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource ShellNavHoverBackgroundBrush}"
                                            />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root Border -->
    <Border
        x:Name="RootBorder"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="0,0,0,1"
        Width="260"
    >
        <Border.RenderTransform>
            <TranslateTransform x:Name="SidebarTranslate" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
                <RowDefinition Height="73" />
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <Grid
                BorderBrush="{StaticResource ShellHeaderDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0"
                VerticalAlignment="Center"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="BrandText"
                    VerticalAlignment="Center"
                    TextWrapping="NoWrap"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{StaticResource ShellTextStrongBrush}"
                >
                    <Run Text="LUMINA " />
                    <Run
                        Text="HAVEN"
                        Foreground="{StaticResource ShellAccentBrush}"
                        FontWeight="Light"
                    />
                </TextBlock>

                <!-- Close Sidebar Button -->
                <Button
                    Grid.Column="1"
                    Style="{StaticResource ShellIconButtonStyle}"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Click="OnCloseSidebarClicked"
                >
                    <Grid Width="18" Height="18">
                        <Path
                            Data="M13.5 4.5L4.5 13.5"
                            Stroke="{StaticResource ShellTextStrongBrush}"
                            StrokeThickness="1.5"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                        />
                        <Path
                            Data="M4.5 4.5L13.5 13.5"
                            Stroke="{StaticResource ShellTextStrongBrush}"
                            StrokeThickness="1.5"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                        />
                    </Grid>
                </Button>
            </Grid>

            <!-- Navigation Items -->
            <StackPanel x:Name="NavItemsPanel" Grid.Row="1" Padding="16,24,16,24" Spacing="8">
                <layout:SidebarNavItem Key="Dashboard" Label="Dashboard">
                    <layout:SidebarNavItem.IconContent>
                        <Canvas Width="22" Height="22">
                            <Path
                                Data="M20.1667 6.41667L12.375 14.2083L7.79167 9.625L1.83333 15.5833"
                                StrokeThickness="2.29"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M14.6667 6.41667H20.1667V11.9167"
                                StrokeThickness="2.29"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                        </Canvas>
                    </layout:SidebarNavItem.IconContent>
                </layout:SidebarNavItem>

                <layout:SidebarNavItem Key="Products" Label="All Products">
                    <layout:SidebarNavItem.IconContent>
                        <Canvas Width="22" Height="22">
                            <Path
                                Data="M19.25 7.33333C19.2497 7.01183 19.1648 6.69608 19.0039 6.41773C18.843 6.13939 18.6118 5.90825 18.3333 5.7475L11.9167 2.08083C11.638 1.91992 11.3218 1.83521 11 1.83521C10.6782 1.83521 10.362 1.91992 10.0833 2.08083L3.66667 5.7475C3.38824 5.90825 3.15698 6.13939 2.99609 6.41773C2.8352 6.69608 2.75033 7.01183 2.75 7.33333V14.6667C2.75033 14.9882 2.8352 15.3039 2.99609 15.5823C3.15698 15.8606 3.38824 16.0918 3.66667 16.2525L10.0833 19.9192C10.362 20.0801 10.6782 20.1648 11 20.1648C11.3218 20.1648 11.638 20.0801 11.9167 19.9192L18.3333 16.2525C18.6118 16.0918 18.843 15.8606 19.0039 15.5823C19.1648 15.3039 19.2497 14.9882 19.25 14.6667V7.33333"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M3.025 6.41667L11 11L18.975 6.41667"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M11 20.1667V11"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                        </Canvas>
                    </layout:SidebarNavItem.IconContent>
                </layout:SidebarNavItem>

                <layout:SidebarNavItem Key="Orders" Label="Order List">
                    <layout:SidebarNavItem.IconContent>
                        <Canvas Width="22" Height="22">
                            <Path
                                Data="M7.33333 20.1667C7.83959 20.1667 8.25 19.7563 8.25 19.25C8.25 18.7437 7.83959 18.3333 7.33333 18.3333C6.82707 18.3333 6.41667 18.7437 6.41667 19.25C6.41667 19.7563 6.82707 20.1667 7.33333 20.1667Z"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M17.4167 20.1667C17.9229 20.1667 18.3333 19.7563 18.3333 19.25C18.3333 18.7437 17.9229 18.3333 17.4167 18.3333C16.9104 18.3333 16.5 18.7437 16.5 19.25C16.5 19.7563 16.9104 20.1667 17.4167 20.1667Z"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M1.87917 1.87917H3.7125L6.15083 13.2642C6.24028 13.6811 6.47228 14.0539 6.8069 14.3182C7.14152 14.5826 7.55783 14.722 7.98417 14.7125H16.9492C17.3664 14.7118 17.7709 14.5688 18.0959 14.3072C18.4209 14.0455 18.647 13.6808 18.7367 13.2733L20.2492 6.4625H4.69333"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                        </Canvas>
                    </layout:SidebarNavItem.IconContent>
                </layout:SidebarNavItem>

                <layout:SidebarNavItem Key="Reports" Label="Reports">
                    <layout:SidebarNavItem.IconContent>
                        <Canvas Width="22" Height="22">
                            <Path
                                Data="M16.5 18.3333V9.16667"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M11 18.3333V3.66667"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                            <Path
                                Data="M5.5 18.3333V12.8333"
                                StrokeThickness="1.83"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stroke="{StaticResource ShellIconMutedBrush}"
                            />
                        </Canvas>
                    </layout:SidebarNavItem.IconContent>
                </layout:SidebarNavItem>
            </StackPanel>

            <!-- Footer Section -->
            <Grid
                x:Name="FooterSection"
                Grid.Row="2"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,16,16,16"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="40"
                    Height="40"
                    Background="{StaticResource ShellAvatarSoftBrush}"
                    BorderBrush="{StaticResource ShellAvatarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                >
                    <TextBlock
                        Text="LH"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource ShellAccentBrush}"
                    />
                </Border>

                <StackPanel
                    x:Name="FooterIdentity"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="1"
                >
                    <TextBlock
                        Text="Admin User"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ShellTextStrongBrush}"
                    />
                    <TextBlock
                        Text="admin@luminahaven.com"
                        FontSize="12"
                        Foreground="{StaticResource ShellTextSubtleBrush}"
                    />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
