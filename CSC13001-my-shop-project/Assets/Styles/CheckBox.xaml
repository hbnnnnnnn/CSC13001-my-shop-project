<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:CSC13001_my_shop_project.Presentation.Controls">
    <Style TargetType="controls:CustomCheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:CustomCheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="CheckBoxBorder"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="5"
                                    BorderThickness="0.77"
                                    BorderBrush="#E8DDD4" 
                                    Background="#80F5EDE4"
                                />

                                <TextBlock
                                    x:Name="CheckGlyph"
                                    Text="✓"
                                    Foreground="White"
                                    FontSize="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                />

                                <ContentPresenter
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Foreground="#A62C2118"
                                    FontSize="13"
                                    Content="{TemplateBinding Content}"
                                    VerticalAlignment="Center"
                                />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
</ResourceDictionary>